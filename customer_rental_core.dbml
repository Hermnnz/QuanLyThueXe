Project customer_rental_core {
  database_type: 'PostgreSQL'
  Note: 'Rental addon-owned tables only. Existing Odoo tables are not redeclared: res_partner (extended with is_rental_customer, rental_id_number, rental_driver_license, rental_notes), res_currency, fleet_vehicle, and fleet_vehicle_model. Odoo owns schema creation; do not run this diagram as DDL.'
}

Table rental_customer_document {
  id integer [pk, increment]
  customer_id integer [not null, note: 'Relation to existing res_partner.id; delete behavior: cascade. The Odoo base table is not redeclared here.']
  name varchar [not null]
  filename varchar [not null]
  document_date date [not null]
  notes varchar

  Note: 'Addon-owned customer documents. PDF bytes are not stored in this table; Odoo Binary field file uses ir_attachment.'
}

Table rental_contract {
  id integer [pk, increment]
  name varchar [not null, note: 'Generated by Odoo sequence RC/YYYY/00001; not a SQL UNIQUE constraint.']
  customer_id integer [not null, note: 'Relation to existing res_partner.id; delete behavior: restrict.']
  currency_id integer [not null, note: 'Relation to Odoo currency; the Odoo base table is outside this diagram.']
  start_date date [not null]
  end_date date [not null]
  deposit_amount numeric [not null, note: 'Odoo default: 0.']
  min_rental_days integer [not null, note: 'Odoo default: 1; must be at least 1.']
  max_rental_days integer [note: 'Odoo default: 0; 0 means no maximum.']
  rental_days integer [note: 'Stored computed field: end_date - start_date.']
  total_amount numeric [note: 'Stored computed field: rental_days multiplied by the sum of line daily rates.']
  state varchar [not null, note: 'Odoo default: draft. Values: draft, confirmed, in_progress, done, cancelled.']
  notes text

  Note: 'Deposit and rental-day limits are stored directly on each contract; there is no rental_config table.'
  indexes {
    (customer_id) [name: 'rental_contract_customer_idx']
    (state) [name: 'rental_contract_state_idx']
  }
}

Table rental_vehicle_type {
  id integer [pk, increment]
  name varchar [not null]
  model_id integer [not null, note: 'Relation to the existing fleet_vehicle_model.id; vehicle models are managed by Odoo Fleet.']
  currency_id integer [not null, note: 'Relation to Odoo currency; the Odoo base table is outside this diagram.']
  daily_rate numeric [not null, note: 'Shared daily price for all vehicles of this type; checked non-negative by Odoo ORM.']
  active boolean

  Note: 'Price list is maintained by vehicle type, not by individual license plate. Brand/model details come from the linked Fleet vehicle model.'
}

Table rental_contract_line {
  id integer [pk, increment]
  contract_id integer [not null]
  vehicle_id integer [not null, note: 'Relation to the existing fleet_vehicle.id; vehicles are managed by Odoo Fleet.']
  vehicle_type_id integer [not null, note: 'Selected price row; relation owned by Customer & Rental.']
  currency_id integer [note: 'Stored related field from the contract currency; the Odoo base table is outside this diagram.']
  daily_rate numeric [not null, note: 'Price snapshot copied from the vehicle type when added to the contract.']
  subtotal numeric [note: 'Stored computed field: rental_contract.rental_days * daily_rate.']

  indexes {
    (contract_id) [name: 'rental_contract_line_contract_idx']
    (vehicle_id) [name: 'rental_contract_line_vehicle_idx']
  }
}

Ref: rental_contract_line.contract_id > rental_contract.id [delete: cascade]
Ref: rental_contract_line.vehicle_type_id > rental_vehicle_type.id [delete: restrict]