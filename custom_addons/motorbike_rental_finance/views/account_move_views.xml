<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_rental_finance" model="ir.ui.view">
        <field name="name">account.move.form.inherit.rental.finance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Thêm trường Hợp đồng thuê xe ngay trên đầu form -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contract_id" 
                       options="{'no_create': True}" 
                       placeholder="Chọn hợp đồng để tự nạp tiền thuê và phụ phí"/>
            </xpath>

            <!-- Ẩn cột Sản phẩm (bàn ghế tủ demo Odoo) -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Giữ khóa ngoại charge_id và price_catalog_id nhưng ẨN hoàn toàn, không hiện lên giao diện -->
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='name']" position="before">
                <field name="charge_id" column_invisible="1"/>
                <field name="price_catalog_id" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
