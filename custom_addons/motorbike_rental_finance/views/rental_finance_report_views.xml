<!-- Thẻ gốc chứa các khai báo giao diện của module Odoo. -->
<odoo>
    <!-- Chỉ dùng khi mở chi tiết từ biểu đồ Odoo; không tạo thêm menu báo cáo riêng. -->
    <!-- Tạo view dạng danh sách; ID này dùng để cập nhật đúng view khi nâng cấp module. -->
    <record id="view_rental_finance_report_list" model="ir.ui.view">
        <!-- Tên kỹ thuật của view danh sách, phục vụ tra cứu/cấu hình trong Odoo. -->
        <field name="name">rental.finance.report.list</field>
        <!-- View này đọc model báo cáo chỉ đọc rental.finance.report. -->
        <field name="model">rental.finance.report</field>
        <!-- arch chứa cấu trúc giao diện viết bằng XML. -->
        <field name="arch" type="xml">
            <!-- create/edit/delete bằng 0 khóa thao tác tạo, sửa, xóa trên màn hình danh sách. -->
            <list create="0" edit="0" delete="0">
                <!-- Cột ngày ghi nhận sự kiện; hóa đơn, phiếu tiền và lượt giao có ngày nguồn riêng. -->
                <field name="report_date"/>
                <!-- Cột tên hoặc mã chứng từ nguồn để người xem nhận diện dòng số liệu. -->
                <field name="name"/>
                <!-- Cột liên kết hợp đồng thuê mà dòng số liệu thuộc về. -->
                <field name="contract_id"/>
                <!-- Cột chỉ tiêu cho biết đây là doanh thu, cọc, dòng tiền hay số lượt. -->
                <field name="metric"/>
                <!-- Cột loại doanh thu giúp tách tiền thuê, dịch vụ, phụ phí và bồi thường. -->
                <field name="category"/>
                <!-- Cột dòng xe dùng khi xem chi tiết lượt xe được thuê. -->
                <field name="vehicle_model_id"/>
                <!-- Hiện tiền tệ nguồn; số liệu Dashboard mới đã được lọc VND trước khi tổng hợp. -->
                <field name="currency_id"/>
                <!-- Cột giá trị: tiền đối với chỉ tiêu tài chính, số 1 đối với dòng đếm lượt/hợp đồng. -->
                <field name="amount"/>
            <!-- Đóng cấu hình danh sách chỉ đọc. -->
            </list>
        <!-- Kết thúc cấu trúc XML của view danh sách. -->
        </field>
    <!-- Kết thúc bản ghi view danh sách. -->
    </record>
    <!-- Tạo view pivot, tức bảng tổng hợp có thể nhóm theo hàng/cột. -->
    <record id="view_rental_finance_report_pivot" model="ir.ui.view">
        <!-- Tên kỹ thuật của view pivot để phân biệt với view danh sách. -->
        <field name="name">rental.finance.report.pivot</field>
        <!-- Pivot vẫn đọc cùng model báo cáo, không tự tạo nguồn tiền khác. -->
        <field name="model">rental.finance.report</field>
        <!-- Bắt đầu cấu trúc XML của bảng tổng hợp. -->
        <field name="arch" type="xml">
            <!-- Đặt tiêu đề tiếng Việt cho bảng pivot. -->
            <pivot string="Nghiệp vụ thuê xe">
                <!-- type=row nhóm các hàng theo chỉ tiêu, tránh gộp cọc và doanh thu thành cùng một loại. -->
                <field name="metric" type="row"/>
                <!-- type=col nhóm cột theo ngày; interval=month gộp dữ liệu trong cùng tháng. -->
                <field name="report_date" type="col" interval="month"/>
                <!-- type=measure chọn giá trị cần cộng; phép cộng được khai báo ở trường amount trong model. -->
                <field name="amount" type="measure"/>
            <!-- Đóng bảng tổng hợp pivot. -->
            </pivot>
        <!-- Đóng cấu trúc XML của view pivot. -->
        </field>
    <!-- Kết thúc bản ghi view pivot. -->
    </record>
    <!-- Tạo view graph để Odoo có thể mở biểu đồ chi tiết từ Dashboard. -->
    <record id="view_rental_finance_report_graph" model="ir.ui.view">
        <!-- Tên kỹ thuật của view biểu đồ. -->
        <field name="name">rental.finance.report.graph</field>
        <!-- Biểu đồ chi tiết dùng cùng dữ liệu báo cáo chỉ đọc. -->
        <field name="model">rental.finance.report</field>
        <!-- Bắt đầu cấu trúc XML của view biểu đồ. -->
        <field name="arch" type="xml">
            <!-- type=bar chọn biểu đồ cột, phù hợp so sánh giá trị theo tháng. -->
            <graph string="Nghiệp vụ thuê xe" type="bar">
                <!-- Gom dữ liệu theo tháng của ngày ghi nhận report_date. -->
                <field name="report_date" interval="month"/>
                <!-- Chọn trường amount làm phép đo để Odoo cộng các dòng trong nhóm. -->
                <field name="amount" type="measure"/>
            <!-- Đóng biểu đồ cột. -->
            </graph>
        <!-- Đóng cấu trúc XML của view biểu đồ. -->
        </field>
    <!-- Kết thúc bản ghi view biểu đồ. -->
    </record>
<!-- Kết thúc toàn bộ khai báo giao diện báo cáo. -->
</odoo>
