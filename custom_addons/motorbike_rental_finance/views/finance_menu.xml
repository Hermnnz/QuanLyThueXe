<odoo>

    <!-- ROOT MENU -->
    <menuitem
        id="menu_motorbike_rental_finance_root"
        name="Tài chính thuê xe"
        sequence="30"
        groups="motorbike_rental_finance.group_motorbike_finance_user"
    />


    <!-- NHÓM GIAO DỊCH -->
    <menuitem
        id="menu_motorbike_rental_finance_transaction"
        name="Giao dịch"
        parent="menu_motorbike_rental_finance_root"
        sequence="10"
    />

    <menuitem
        id="menu_motorbike_rental_payment"
        name="Thanh toán"
        parent="menu_motorbike_rental_finance_transaction"
        action="action_motorbike_rental_payment"
        sequence="10"
    />

    <menuitem
        id="menu_motorbike_rental_charge"
        name="Khoản phát sinh"
        parent="menu_motorbike_rental_finance_transaction"
        action="action_motorbike_rental_charge"
        sequence="20"
    />

        <!-- Thêm menu Hóa đơn vào trong nhóm Giao dịch của Finance -->
    <menuitem
        id="menu_finance_account_invoice"
        name="Hóa đơn"
        parent="menu_motorbike_rental_finance_transaction"
        action="account.action_move_out_invoice_type"
        sequence="30"
    />


    <!-- NHÓM CẤU HÌNH -->
    <menuitem
        id="menu_motorbike_rental_finance_configuration"
        name="Cấu hình"
        parent="menu_motorbike_rental_finance_root"
        sequence="30"
    />

    <menuitem
        id="menu_motorbike_rental_price_catalog"
        name="Bảng giá"
        parent="menu_motorbike_rental_finance_configuration"
        action="action_motorbike_rental_price_catalog"
        sequence="10"
    />
    <record id="menu_motorbike_rental_finance_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

        <!-- NHÓM BÁO CÁO -->
    <menuitem
        id="menu_motorbike_rental_finance_reporting"
        name="Báo cáo"
        parent="menu_motorbike_rental_finance_root"
        sequence="20"
    />

    <menuitem
        id="menu_finance_dashboard"
        name="Tổng quan doanh thu"
        parent="menu_motorbike_rental_finance_reporting"
        action="spreadsheet_dashboard.ir_actions_dashboard_action"
        sequence="5"
    />

    <menuitem
        id="menu_report_payment"
        name="Báo cáo dòng tiền"
        parent="menu_motorbike_rental_finance_reporting"
        action="action_motorbike_rental_payment_report"
        sequence="10"
    />

    <menuitem
        id="menu_report_charge"
        name="Báo cáo phụ phí"
        parent="menu_motorbike_rental_finance_reporting"
        action="action_motorbike_rental_charge_report"
        sequence="20"
    />

        <!-- Ẩn icon Hóa đơn gốc của Odoo ngoài màn hình chính -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

        <!-- Ẩn icon Liên hệ gốc của Odoo ngoài màn hình chính -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!--  Ẩn icon Báo cáo tổng quan gốc ngoài màn hình chính -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

        <!-- Ẩn Trình theo dõi Liên kết (Link Tracker / UTM) ngoài màn hình chính -->
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>



</odoo>
