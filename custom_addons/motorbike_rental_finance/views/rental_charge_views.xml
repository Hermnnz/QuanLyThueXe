<odoo>
    <record id="view_motorbike_rental_charge_list"  model="ir.ui.view">
        <field name="name">motorbike.rental.charge.list</field>
        <field name="model">motorbike.rental.charge</field>
        <field name="arch" type="xml">
            <list string="Khoản phát sinh">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="contract_id"/>
                <field name="price_catalog_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="charge_date"/>
                <field name="state"/>
            </list>
        </field>
    </record> 

    <record id="view_motorbike_rental_charge_form" model="ir.ui.view">
        <field name="name">motorbike.rental.charge.form</field>
        <field name="model">motorbike.rental.charge</field>
        <field name="arch" type ="xml">
            <form string="Khoản phát sinh">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <!-- Phụ phí được gộp vào hóa đơn cuối hợp đồng, không tạo hóa đơn riêng tại đây. -->
                    <button name="action_cancel" string="Hủy bỏ" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" string="Về bản nháp" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>   
                </header>
                <sheet>
                    <group string="Thông tin khoản phát sinh">
                        <field name="name"/>
                        <field name="customer_id"/>
                        
                    </group>
                    <group string="Thông tin tính phí">
                        <field name="price_catalog_id"/>
                        <field name="quantity"/>
                        <field name="unit_price"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                    </group>

                    <group string="Liên kết hợp đồng">
                        <field name="contract_id"/>
                        <field name="ticket_id"/>
                        <field name="incident_id"/>
                    </group>

                    <group string="Thời gian">
                        <field name="charge_date"/>
                    </group>
                    <group string="Liên kết hóa đơn">
                        <field name="invoice_id"/>
                    </group>
                    <group string="Ghi chú">
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_motorbike_rental_charge_search" model="ir.ui.view">

    <field name="name">motorbike.rental.charge.search</field>

    <field name="model">motorbike.rental.charge</field>

    <field name="arch" type="xml">

        <search string="Tìm kiếm khoản phát sinh">
            <!--Tìm kiếm theo trường-->
            <field name="name"/>
            <field name="customer_id"/>
            <field name="price_catalog_id"/>
            <field name="charge_date"/>

            <!--filter bộ lọc-->
            <filter name="filter_draft" string="Bản nháp" domain="[('state','=','draft')]"/>
            <filter name="filter_confirmed" string="Đã xác nhận" domain="[('state','=','confirmed')]"/>
            <filter name="filter_cancelled" string="Đã hủy" domain="[('state','=','cancelled')]"/>

            <!--Gom nhóm -->
            <group expand="0" string="Nhóm theo">
                    <filter string="Khách hàng" name="group_charge_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Hợp đồng" name="group_charge_contract" context="{'group_by': 'contract_id'}"/>
                    <filter string="Bảng giá" name="group_charge_catalog" context="{'group_by': 'price_catalog_id'}"/>
                    <filter string="Trạng thái" name="group_charge_state" context="{'group_by': 'state'}"/>
                    <filter string="Ngày ghi nhận" name="group_charge_date" context="{'group_by': 'charge_date'}"/>
            </group>
        </search>

    </field>

    </record>


    
    <!-- Pivot View biểu đồ-->
    <record id="view_motorbike_rental_charge_pivot" model="ir.ui.view">
        <field name="name">motorbike.rental.charge.pivot</field>
        <field name="model">motorbike.rental.charge</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích phụ phí phát sinh" sample="1">
                <field name="charge_date" interval="month" type="row"/>
                <field name="price_catalog_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>


    <!--Graph View biểu đồ-->
    <record id="view_motorbike_rental_charge_graph" model="ir.ui.view">
        <field name="name">motorbike.rental.charge.graph</field>
        <field name="model">motorbike.rental.charge</field>
        <field name="arch" type="xml">
            <graph string="Biểu đồ phụ phí phát sinh" type="bar" sample="1">
                <field name="price_catalog_id"/>
                <field name="charge_date" interval="month"/>
                <field name="amount"/>
            </graph>
        </field>
    </record>
</odoo>
