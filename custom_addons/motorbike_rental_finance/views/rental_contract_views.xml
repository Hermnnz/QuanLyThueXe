<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Kế thừa Form View Hợp đồng của Nhân -->
    <record id="view_rental_contract_form_inherit_finance" model="ir.ui.view">
        <field name="name">rental.contract.form.inherit.finance</field>
        <field name="model">rental.contract</field>
        
        <!-- ref trỏ tới view gốc trong module core của Nhân -->
        <field name="inherit_id" ref="motorbike_rental_core.view_rental_contract_form"/>
        <field name="arch" type="xml">

            <!-- 1. Chèn nút Quyết toán vào Header trước nút Hoàn tất -->
            <xpath expr="//header/button[@name='action_done']" position="before">
                <button name="action_settlement" 
                        type="object" 
                        string="Quyết toán thanh toán" 
                        class="oe_highlight" 
                        invisible="state != 'in_progress'"/>
            </xpath>

            <!-- 2. Chèn 2 Tab hiển thị Phụ phí và Lịch sử thanh toán vào dưới Sheet -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Phụ phí phát sinh">
                        <field name="charge_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="price_catalog_id"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                                <field name="amount"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Lịch sử thanh toán">
                        <field name="payment_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="transaction_type"/>
                                <field name="amount"/>
                                <field name="payment_method"/>
                                <field name="payment_date"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>
</odoo>