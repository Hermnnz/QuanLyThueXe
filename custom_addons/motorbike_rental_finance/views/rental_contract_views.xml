<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Kế thừa Form View Hợp đồng của Nhân -->
    <record id="view_rental_contract_form_inherit_finance" model="ir.ui.view">
        <field name="name">rental.contract.form.inherit.finance</field>
        <field name="model">rental.contract</field>
        
        <!-- ref trỏ tới view gốc trong module core của Nhân -->
        <field name="inherit_id" ref="motorbike_rental_core.view_rental_contract_form"/>
        <field name="arch" type="xml">

            <!-- 1. Nhân viên kết thúc hợp đồng bằng nút Xác nhận hóa đơn, không bấm Hoàn tất riêng.
                 xpath tìm nút action_done trong header (thanh nút phía trên) của giao diện Core.
                 position="attributes" sửa thuộc tính nút đã có, không tạo hoặc xóa nút trong Core.
                 invisible = 1 nghĩa là luôn ẩn nút Hoàn tất trên form hợp đồng khi có module Finance.
                 Hàm write trong rental_contract.py vẫn kiểm tra ở server để không thể bỏ qua bằng code. -->
            <xpath expr="//header/button[@name='action_done']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Chỉ hiện nút Hủy khi hợp đồng còn nháp hoặc đã ký nhưng chưa bắt đầu thuê.
                 Với hợp đồng đã ký, Python còn kiểm tra từng dòng xe trước khi mở phiếu hoàn cọc. -->
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'confirmed')</attribute>
            </xpath>

            <!-- Một ô xác nhận đã nhận cả cọc và tiền thuê; bắt buộc tích trước khi ký hợp đồng. -->
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Tiền đã nhận" invisible="state != 'draft'">
                    <field name="upfront_received_check"/>
                    <!-- Nhân viên chọn một phương thức cho cả cọc và tiền thuê trước khi ký hợp đồng. -->
                    <field name="upfront_payment_method" required="upfront_received_check"/>
                </group>
            </xpath>

            <!-- 2. Chèn 2 Tab hiển thị Phụ phí và Lịch sử thanh toán vào dưới Sheet -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Phụ phí phát sinh">
                        <field name="charge_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="price_catalog_id"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                                <field name="amount"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Lịch sử thanh toán">
                        <field name="payment_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="transaction_type"/>
                                <field name="amount"/>
                                <field name="payment_method"/>
                                <field name="payment_date"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>

        </field>
    </record>
</odoo>
