<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Demo customers -->
    <record id="demo_partner_nguyen_van_an" model="res.partner">
        <field name="name">Nguyễn Văn An</field>
        <field name="phone">0901234567</field>
    </record>

    <record id="demo_partner_tran_thi_binh" model="res.partner">
        <field name="name">Trần Thị Bình</field>
        <field name="phone">0912345678</field>
    </record>

    <!-- Price catalogs -->
    <record id="demo_price_delivery_service" model="motorbike.rental.price.catalog">
        <field name="name">Giao xe tận nơi</field>
        <field name="code">DV-GIAO-XE</field>
        <field name="category">service</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">100000</field>
        <field name="unit">time</field>
        <field name="effective_from">2026-01-01</field>
        <field name="note">Phí giao xe trong khu vực nội thành.</field>
    </record>

    <record id="demo_price_cleaning_service" model="motorbike.rental.price.catalog">
        <field name="name">Vệ sinh xe</field>
        <field name="code">DV-VE-SINH</field>
        <field name="category">service</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">80000</field>
        <field name="unit">time</field>
        <field name="effective_from">2026-01-01</field>
        <field name="note">Áp dụng khi xe cần vệ sinh đặc biệt sau khi hoàn trả.</field>
    </record>

    <record id="demo_price_late_fee" model="motorbike.rental.price.catalog">
        <field name="name">Phí trả xe trễ</field>
        <field name="code">PT-TRE-50K</field>
        <field name="category">surcharge</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">50000</field>
        <field name="unit">hour</field>
        <field name="effective_from">2026-01-01</field>
        <field name="note">Tính 50.000 VND cho mỗi giờ trả xe trễ.</field>
    </record>

    <record id="demo_price_other_processing_fee" model="motorbike.rental.price.catalog">
        <field name="name">Phí xử lý khác</field>
        <field name="code">PT-XU-LY</field>
        <field name="category">surcharge</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">30000</field>
        <field name="unit">time</field>
        <field name="effective_from">2026-01-01</field>
        <field name="note">Khoản phụ phí xử lý phát sinh ngoài các trường hợp thông thường.</field>
    </record>

    <record id="demo_price_lost_helmet" model="motorbike.rental.price.catalog">
        <field name="name">Bồi thường mất mũ bảo hiểm</field>
        <field name="code">BT-MU-BH</field>
        <field name="category">compensation</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">250000</field>
        <field name="unit">item</field>
        <field name="effective_from">2026-01-01</field>
    </record>

    <record id="demo_price_lost_charger" model="motorbike.rental.price.catalog">
        <field name="name">Bồi thường mất bộ sạc</field>
        <field name="code">BT-BO-SAC</field>
        <field name="category">compensation</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">500000</field>
        <field name="unit">set</field>
        <field name="effective_from">2026-01-01</field>
    </record>

    <!-- Payments -->
    <record id="demo_payment_deposit_01" model="motorbike.rental.payment">
        <field name="name">DP-20260920-001</field>
        <field name="customer_id" ref="demo_partner_nguyen_van_an"/>
        <field name="transaction_type">deposit</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="amount">500000</field>
        <field name="payment_method">bank_transfer</field>
        <field name="payment_date">2026-09-20</field>
        <field name="reference">MBR-DP-001</field>
        <field name="state">confirmed</field>
    </record>

    <record id="demo_payment_rental_01" model="motorbike.rental.payment">
        <field name="name">RP-20260921-001</field>
        <field name="customer_id" ref="demo_partner_nguyen_van_an"/>
        <field name="transaction_type">rental_payment</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="amount">350000</field>
        <field name="payment_method">cash</field>
        <field name="payment_date">2026-09-21</field>
        <field name="reference">MBR-RP-001</field>
        <field name="state">confirmed</field>
    </record>

    <!-- Phiếu thu thêm/hoàn tiền chỉ sinh từ hóa đơn cuối hợp đồng, không tạo mẫu trực tiếp. -->

    <!-- Rental charges -->
    <record id="demo_charge_delivery_01" model="motorbike.rental.charge">
        <field name="name">Phí giao xe tận nơi - Nguyễn Văn An</field>
        <field name="customer_id" ref="demo_partner_nguyen_van_an"/>
        <field name="price_catalog_id" ref="demo_price_delivery_service"/>
        <field name="quantity">1</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">100000</field>
        <field name="charge_date">2026-09-20</field>
        <field name="state">confirmed</field>
    </record>

    <record id="demo_charge_late_fee_01" model="motorbike.rental.charge">
        <field name="name">Phí trả xe trễ 2 giờ - Nguyễn Văn An</field>
        <field name="customer_id" ref="demo_partner_nguyen_van_an"/>
        <field name="price_catalog_id" ref="demo_price_late_fee"/>
        <field name="quantity">2</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">50000</field>
        <field name="charge_date">2026-09-21</field>
        <field name="state">confirmed</field>
        <field name="note">Khách trả xe trễ 2 giờ.</field>
    </record>

    <record id="demo_charge_cleaning_01" model="motorbike.rental.charge">
        <field name="name">Phí vệ sinh xe - Trần Thị Bình</field>
        <field name="customer_id" ref="demo_partner_tran_thi_binh"/>
        <field name="price_catalog_id" ref="demo_price_cleaning_service"/>
        <field name="quantity">1</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">80000</field>
        <field name="charge_date">2026-09-22</field>
        <field name="state">draft</field>
    </record>

    <record id="demo_charge_lost_helmet_01" model="motorbike.rental.charge">
        <field name="name">Bồi thường mất mũ bảo hiểm - Trần Thị Bình</field>
        <field name="customer_id" ref="demo_partner_tran_thi_binh"/>
        <field name="price_catalog_id" ref="demo_price_lost_helmet"/>
        <field name="quantity">1</field>
        <field name="currency_id" ref="base.VND"/>
        <field name="unit_price">250000</field>
        <field name="charge_date">2026-09-23</field>
        <field name="state">confirmed</field>
    </record>
</odoo>
