<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_delivery_receipt" model="ir.actions.act_window">
        <field name="name">Biên Lai Giao Xe</field>
        <field name="res_model">rental.delivery.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rental_delivery_receipt_tree" model="ir.ui.view">
        <field name="name">rental.delivery.receipt.list</field>
        <field name="model">rental.delivery.receipt</field>
        <field name="arch" type="xml">
            <list string="Biên Lai Giao Xe" create="0" class="o_rental_receipt_list_table">
                <field name="name" width="130px"/>
                <field name="delivery_date" width="140px"/>
                <field name="delivery_time" width="110px"/>
                <field name="customer_id" width="180px"/>
                <field name="customer_phone" widget="phone" optional="show" width="130px"/>
                <field name="ticket_id" width="160px"/>
                <field name="qty_helmet" string="Mũ bảo hiểm" width="130px"/>
                <field name="qty_raincoat" string="Áo mưa" width="120px"/>
                <field name="qty_phone_holder" string="Giá đỡ điện thoại" width="160px"/>
                <field name="qty_charger" string="Bộ sạc xe" width="130px"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" width="140px"/>
            </list>
        </field>
    </record>

    <record id="view_rental_delivery_receipt_form" model="ir.ui.view">
        <field name="name">rental.delivery.receipt.form</field>
        <field name="model">rental.delivery.receipt</field>
        <field name="arch" type="xml">
            <form string="Biên Lai Giao Xe">
                <header>
                    <button name="action_print_receipt" 
                            type="object" 
                            string="In Biên Lai (PDF)" 
                            class="oe_highlight" 
                            icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Số Biên Lai"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Khách hàng">
                            <field name="ticket_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="customer_phone" readonly="1"/>
                        </group>
                        <group string="Thời gian &amp; Nhân sự giao xe">
                            <field name="delivery_date" readonly="1"/>
                            <field name="delivery_time" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Danh sách xe bàn giao &amp; Ngoại quan" name="vehicles">
                            <field name="vehicle_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="vehicle_id" string="Xe"/>
                                    <field name="delivery_time" string="Giờ giao"/>
                                    <field name="delivery_visual_note" string="Tình trạng ngoại quan ban đầu"/>
                                    <field name="status" widget="badge" 
                                           decoration-info="status == 'waiting'" 
                                           decoration-primary="status == 'delivering'" 
                                           decoration-warning="status == 'renting'" 
                                           decoration-success="status == 'returned'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Trang thiết bị kèm theo" name="accessories">
                            <group string="Số lượng phụ kiện bàn giao theo biên lai">
                                <group>
                                    <field name="qty_helmet" readonly="1"/>
                                    <field name="qty_raincoat" readonly="1"/>
                                </group>
                                <group>
                                    <field name="qty_phone_holder" readonly="1"/>
                                    <field name="qty_charger" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
