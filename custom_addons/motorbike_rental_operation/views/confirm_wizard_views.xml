<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
    <!-- POPUP FORM XÁC NHẬN THAO TÁC HÀNG LOẠT (MỞ TỪ CÁC NÚT BULK BÊN TICKET) -->
    <!-- <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< -->
    <record id="view_rental_operation_confirm_wizard_form" model="ir.ui.view">
        <field name="name">rental.operation.confirm.wizard.form</field>
        <field name="model">rental.operation.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Xác nhận Thao tác Vận Hành">
                <sheet>
                    <!-- Hộp cảnh báo màu vàng hiển thị nội dung câu hỏi xác nhận (truyền từ context default_message) -->
                    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                        <i class="fa fa-question-circle fa-2x me-3 text-warning"/>
                        <div>
                            <field name="message" readonly="1" class="fw-bold fs-5 text-dark"/>
                        </div>
                    </div>
                </sheet>
                <!-- Thanh nút bấm đáy popup -->
                <footer>
                    <button name="action_apply" type="object" string="Xác nhận" class="btn-primary"/> <!-- Gọi hàm action_apply trong rental_operation_confirm_wizard.py -->
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel"/> <!-- special="cancel": tự đóng popup không gọi Python -->
                </footer>
            </form>
        </field>
    </record>
</odoo>
