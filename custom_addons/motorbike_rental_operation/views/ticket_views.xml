<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_operation_ticket" model="ir.actions.act_window">
        <field name="name">Phiếu Vận Hành (Giao/Thu Hồi Xe)</field>
        <field name="res_model">rental.operation.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_operation': 1}</field>
    </record>

    <record id="view_rental_operation_ticket_tree" model="ir.ui.view">
        <field name="name">rental.operation.ticket.list</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <list string="Phiếu Vận Hành (Giao/Thu Hồi Xe)" class="o_rental_ticket_list_table" delete="0">
                <field name="currency_id" column_invisible="1"/>
                <field name="name" width="130px"/>
                <field name="contract_id" width="160px"/>
                <field name="customer_id" width="180px"/>
                <field name="customer_phone" widget="phone" optional="show" width="130px"/>
                <field name="rental_order_ref" width="140px"/>
                <field name="quick_delivery_location" string="Vị trí giao xe" width="180px" optional="show"/>
                <field name="expected_checkout" width="175px"/>
                <field name="expected_checkin" width="175px"/>
                <field name="waiting_count" string="Chờ giao" optional="show" width="90px"/>
                <field name="delivering_count" string="Đang giao" optional="show" width="90px"/>
                <field name="renting_count" string="Đang thuê" optional="show" width="90px"/>
                <field name="returned_count" string="Đã thu hồi" optional="show" width="90px"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'waiting'" 
                       decoration-warning="state == 'in_progress'" 
                       decoration-success="state == 'done'" 
                       decoration-danger="state == 'contract_cancelled'" width="150px"/>
            </list>
        </field>
    </record>

    <record id="view_rental_operation_ticket_form" model="ir.ui.view">
        <field name="name">rental.operation.ticket.form</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <form string="Phiếu Vận Hành" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,in_progress,done"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="available_contract_ids" invisible="1"/>
                    <field name="waiting_count" invisible="1"/>
                    <field name="delivering_count" invisible="1"/>
                    <field name="renting_count" invisible="1"/>
                    <field name="returned_count" invisible="1"/>
                    <field name="has_selected_vehicles" invisible="1"/>
                    <field name="has_selected_receipts" invisible="1"/>
                    <field name="has_selected_return_receipts" invisible="1"/>
                    <field name="contract_state" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-clock-o" type="object" name="action_view_vehicles">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="waiting_count"/></span>
                                <span class="o_stat_text">Chờ giao</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-truck" type="object" name="action_view_vehicles">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="delivering_count"/></span>
                                <span class="o_stat_text">Đang giao</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-motorcycle" type="object" name="action_view_vehicles">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="renting_count"/></span>
                                <span class="o_stat_text">Đang thuê</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle" type="object" name="action_view_vehicles">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="returned_count"/></span>
                                <span class="o_stat_text">Đã thu hồi</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-file-text-o" type="object" name="action_view_delivery_receipts">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="receipt_count"/></span>
                                <span class="o_stat_text">Biên lai giao</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-undo" type="object" name="action_view_return_receipts">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="return_receipt_count"/></span>
                                <span class="o_stat_text">Biên lai thu hồi</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-exchange" type="object" name="action_view_vehicle_exchanges">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="vehicle_exchange_count"/></span>
                                <span class="o_stat_text">Đổi xe</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" force_save="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin Hợp đồng &amp; Khách hàng">
                            <field name="contract_id" domain="[('id', 'in', available_contract_ids)]" options="{'no_create': True}" placeholder="Chọn hợp đồng để tự động điền..." readonly="state != 'waiting'"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="customer_phone" widget="phone" readonly="1"/>
                        </group>
                        <group string="Thời gian thuê">
                            <field name="expected_checkout" string="Thời gian giao xe" readonly="1"/>
                            <field name="expected_checkin" string="Thời gian thu hồi" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tất cả xe bàn giao" name="vehicles">
                            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                                <button name="action_select_all_vehicles" type="object" string="Chọn tất cả" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_deselect_all_vehicles" type="object" string="Bỏ chọn" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_bulk_update_schedule" type="object" string="Cập nhật địa điểm / thời gian" class="btn btn-outline-primary btn-sm ms-4" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done' or not has_selected_vehicles"/>
                                <div class="ms-auto d-flex align-items-center gap-2">
                                    <button name="action_new_vehicle_exchange" type="object" string="Đổi xe" class="btn btn-outline-primary btn-sm" invisible="contract_state != 'in_progress'"/>
                                    <button name="action_open_delivery_receipt_wizard" type="object" string="Xuất biên lai giao xe" class="btn btn-info btn-sm text-white" icon="fa-print" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                    <button name="action_open_return_receipt_wizard" type="object" string="Xuất biên lai thu hồi xe" class="btn btn-danger btn-sm text-white" icon="fa-print" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                </div>
                            </div>
                            <field name="vehicle_detail_ids" readonly="state in ('done', 'contract_cancelled')" context="{'default_date_checkout': expected_checkout, 'default_date_checkin': expected_checkin, 'default_delivery_location': 'Tại cửa hàng', 'default_return_location': 'Tại cửa hàng'}">
                                <list create="0" delete="0" editable="bottom">
                                     <field name="currency_id" column_invisible="1"/>
                                     <field name="is_selected" string="Chọn" width="45px" class="o_ticket_select_checkbox" readonly="parent.state in ('done', 'contract_cancelled') or parent.contract_state == 'done'"/>
                                     <field name="vehicle_id" readonly="1" force_save="1" width="180px"/>
                                     <field name="delivery_receipt_id" column_invisible="1"/>
                                     <field name="date_checkout" string="Thời gian giao dự kiến" readonly="1" force_save="1" width="175px"/>
                                     <field name="actual_delivery_date" string="Thời gian giao thực tế" optional="show" readonly="parent.state in ('done', 'contract_cancelled')" width="175px"/>
                                     <field name="delivery_location" string="Vị trí giao" optional="show" readonly="status in ('renting', 'returned') or parent.state in ('done', 'contract_cancelled')" width="200px"/>
                                     <field name="delivery_date" string="Ngày giao" optional="show" readonly="status in ('renting', 'returned') or parent.state in ('done', 'contract_cancelled')" width="125px"/>
                                     <field name="delivery_time" string="Giờ giao" optional="show" readonly="status in ('renting', 'returned') or parent.state in ('done', 'contract_cancelled')" width="110px"/>
                                     <field name="date_checkin" string="Thời gian thu hồi dự kiến" readonly="1" force_save="1" width="175px"/>
                                     <field name="actual_return_date" string="Thời gian thu hồi thực tế" optional="show" readonly="parent.state in ('done', 'contract_cancelled')" width="175px"/>
                                     <field name="return_location" string="Vị trí thu hồi" optional="show" readonly="status == 'returned' or parent.state in ('done', 'contract_cancelled')" width="200px"/>
                                     <field name="return_date" string="Ngày thu hồi" optional="show" readonly="status == 'returned' or parent.state in ('done', 'contract_cancelled')" width="125px"/>
                                     <field name="return_time" string="Giờ thu hồi" optional="show" readonly="status == 'returned' or parent.state in ('done', 'contract_cancelled')" width="110px"/>
                                     <field name="qty_helmet" optional="hide" readonly="1" string="Mũ bảo hiểm" width="130px"/>
                                     <field name="qty_raincoat" optional="hide" readonly="1" string="Áo mưa" width="120px"/>
                                     <field name="qty_phone_holder" optional="hide" readonly="1" string="Giá đỡ điện thoại" width="160px"/>
                                     <field name="qty_charger" optional="hide" readonly="1" string="Bộ sạc xe" width="130px"/>
                                     <field name="delivery_visual_note" optional="show" readonly="1" string="Tình trạng ngoại quan" width="240px"/>
                                     <field name="status" widget="badge" readonly="1" force_save="1"
                                            decoration-info="status == 'waiting'" 
                                            decoration-primary="status == 'delivering'" 
                                            decoration-warning="status == 'renting'" 
                                            decoration-success="status == 'returned'" 
                                            class="text-start text-left" width="140px"/>
                                 </list>
                                 <form delete="0">
                                     <sheet>
                                         <field name="currency_id" invisible="1"/>
                                         <group>
                                             <group string="Thông tin chung">
                                                 <field name="is_selected" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                                 <field name="vehicle_id" readonly="1" force_save="1"/>
                                                 <field name="status" readonly="1"/>
                                             </group>
                                             <group string="Lịch trình &amp; Vị trí Giao xe">
                                                 <field name="date_checkout" string="Thời gian giao dự kiến" readonly="1" force_save="1"/>
                                                 <field name="actual_delivery_date" string="Thời gian giao thực tế" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                                 <field name="delivery_location" string="Vị trí giao" readonly="status in ('renting', 'returned') or parent.state in ('done', 'contract_cancelled')"/>
                                                 <field name="delivery_date" string="Ngày giao" readonly="status in ('renting', 'returned') or parent.state in ('done', 'contract_cancelled')"/>
                                                 <field name="delivery_time" string="Giờ giao" readonly="status in ('renting', 'returned') or parent.state in ('done', 'contract_cancelled')"/>
                                             </group>
                                         </group>
                                         <group string="Lịch trình &amp; Vị trí Thu hồi Xe">
                                             <field name="date_checkin" string="Thời gian thu hồi dự kiến" readonly="1" force_save="1"/>
                                             <field name="actual_return_date" string="Thời gian thu hồi thực tế" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="return_location" string="Vị trí thu hồi" readonly="status == 'returned' or parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="return_date" string="Ngày thu hồi" readonly="status == 'returned' or parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="return_time" string="Giờ thu hồi" readonly="status == 'returned' or parent.state in ('done', 'contract_cancelled')"/>
                                         </group>
                                         <group string="Phụ kiện bàn giao">
                                             <field name="delivery_receipt_id" invisible="1"/>
                                             <field name="receipt_printed_at" invisible="1"/>
                                             <field name="qty_helmet" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="qty_raincoat" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="qty_phone_holder" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="qty_charger" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                             <field name="delivery_visual_note" readonly="parent.state in ('done', 'contract_cancelled')"/>
                                         </group>
                                     </sheet>
                                 </form>
                             </field>
                        </page>
                        <page string="Biên lai giao xe" name="delivery_receipts">
                            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                                <button name="action_select_all_receipts" type="object" string="Chọn tất cả" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_deselect_all_receipts" type="object" string="Bỏ chọn" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_bulk_start_delivery_receipts" type="object" string="Bắt đầu giao xe" class="btn btn-primary btn-sm ms-4" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done' or not has_selected_receipts"/>
                                <button name="action_bulk_confirm_delivery_receipts" type="object" string="Xác nhận đã giao" class="btn btn-warning btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done' or not has_selected_receipts"/>
                            </div>
                            <field name="receipt_ids" readonly="state in ('done', 'contract_cancelled')">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="is_selected" string="Chọn" width="45px" class="o_ticket_select_checkbox"/>
                                    <field name="name" string="Mã biên lai" readonly="1" width="130px"/>
                                    <button name="action_open_receipt_detail" type="object" string="Chi tiết" icon="fa-eye" class="btn btn-sm btn-link text-primary" width="90px"/>
                                    <field name="customer_id" string="Khách nhận xe" readonly="1" width="180px"/>
                                    <field name="customer_phone" string="Số điện thoại" readonly="1" width="130px"/>
                                    <field name="delivery_date" string="Ngày giao" readonly="1" width="120px"/>
                                    <field name="delivery_time" string="Giờ giao" readonly="1" width="100px"/>
                                    <field name="delivery_location" string="Địa điểm giao" readonly="1" width="180px"/>
                                    <field name="qty_helmet" string="Mũ BH" readonly="1" width="90px"/>
                                    <field name="qty_raincoat" string="Áo mưa" readonly="1" width="90px"/>
                                    <field name="qty_phone_holder" string="Giá ĐT" readonly="1" width="90px"/>
                                    <field name="qty_charger" string="Sạc xe" readonly="1" width="90px"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-info="state == 'pending'" 
                                           decoration-primary="state == 'delivering'" 
                                           decoration-success="state == 'delivered'" 
                                           width="140px"/>
                                    <button name="action_print_receipt" type="object" string="In" icon="fa-print" class="btn btn-sm btn-link text-primary" title="In Biên Lai (PDF)" width="60px"/>
                                </list>
                                <form string="Biên Lai Giao Xe" create="0" edit="0" delete="0">
                                    <header>
                                        <button name="action_print_receipt" 
                                                type="object" 
                                                string="In Biên Lai (PDF)" 
                                                class="oe_highlight" 
                                                icon="fa-print"/>
                                        <field name="state" widget="statusbar" statusbar_visible="pending,delivering,delivered" readonly="1"/>
                                    </header>
                                    <sheet>
                                        <field name="ticket_id" invisible="1"/>
                                        <div class="oe_title mb-2">
                                            <label for="name" string="Số Biên Lai"/>
                                            <h1 class="text-primary"><field name="name" readonly="1"/></h1>
                                        </div>
                                        <group>
                                            <group string="Khách hàng nhận xe">
                                                <field name="customer_id" string="Khách hàng" readonly="1"/>
                                                <field name="customer_phone" string="Số điện thoại" widget="phone" readonly="1"/>
                                            </group>
                                            <group string="Thời gian &amp; Địa điểm giao">
                                                <field name="delivery_time" string="Giờ giao xe" readonly="1"/>
                                                <field name="delivery_date" string="Ngày giao xe" readonly="1"/>
                                                <field name="delivery_location" string="Địa điểm giao xe" readonly="1"/>
                                                <field name="user_id" string="Nhân viên giao xe" readonly="1"/>
                                            </group>
                                        </group>

                                        <div class="o_horizontal_separator text-uppercase fw-bold mt-2 mb-2" style="font-size: 12px; color: #495057;">
                                            <i class="fa fa-cubes me-1"/> Phụ kiện kèm theo (Bàn giao theo nhóm xe)
                                        </div>
                                        <group>
                                            <group>
                                                <field name="qty_helmet" string="Mũ bảo hiểm (cái)" readonly="1"/>
                                                <field name="qty_raincoat" string="Áo mưa (cái)" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="qty_phone_holder" string="Giá đỡ ĐT / Màn hình (cái)" readonly="1"/>
                                                <field name="qty_charger" string="Bộ sạc xe (bộ)" readonly="1"/>
                                            </group>
                                        </group>

                                        <div class="o_horizontal_separator text-uppercase fw-bold mt-3 mb-2" style="font-size: 12px; color: #495057;">
                                            <i class="fa fa-motorcycle me-1"/> Thông tin xe &amp; Tình trạng ngoại quan ban đầu
                                        </div>
                                        <field name="vehicle_ids" readonly="1">
                                            <list create="0" edit="0" delete="0">
                                                <field name="vehicle_id" string="Xe" readonly="1"/>
                                                <field name="license_plate" string="Biển số" readonly="1"/>
                                                <field name="delivery_date" string="Ngày giao" readonly="1" optional="show"/>
                                                <field name="delivery_time" string="Giờ giao" readonly="1"/>
                                                <field name="delivery_location" string="Vị trí giao" readonly="1" optional="show"/>
                                                <field name="delivery_visual_note" string="Tình trạng ngoại quan ban đầu (vết xước, phụ kiện...)" readonly="1"/>
                                                <field name="status" widget="badge" 
                                                       decoration-info="status == 'waiting'" 
                                                       decoration-primary="status == 'delivering'" 
                                                       decoration-warning="status == 'renting'" 
                                                       decoration-success="status == 'returned'" 
                                                       string="Trạng thái xe" readonly="1"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Biên lai thu hồi xe" name="return_receipts">
                            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                                <button name="action_select_all_return_receipts" type="object" string="Chọn tất cả" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_deselect_all_return_receipts" type="object" string="Bỏ chọn" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_bulk_confirm_return_receipts" type="object" string="Xác nhận đã thu hồi" class="btn btn-success btn-sm ms-4" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done' or not has_selected_return_receipts"/>
                            </div>
                            <field name="return_receipt_ids" readonly="state in ('done', 'contract_cancelled')">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="is_selected" string="Chọn" width="45px" class="o_ticket_select_checkbox"/>
                                    <field name="name" string="Mã biên lai" readonly="1" width="130px"/>
                                    <button name="action_open_receipt_detail" type="object" string="Chi tiết" icon="fa-eye" class="btn btn-sm btn-link text-success" width="90px"/>
                                    <field name="customer_id" string="Khách trả xe" readonly="1" width="180px"/>
                                    <field name="customer_phone" string="Số điện thoại" readonly="1" width="130px"/>
                                    <field name="return_date" string="Ngày thu hồi" readonly="1" width="120px"/>
                                    <field name="return_time" string="Giờ thu hồi" readonly="1" width="100px"/>
                                    <field name="return_location" string="Địa điểm thu hồi" readonly="1" width="180px"/>
                                    <field name="qty_helmet" string="Mũ BH" readonly="1" width="90px"/>
                                    <field name="qty_raincoat" string="Áo mưa" readonly="1" width="90px"/>
                                    <field name="qty_phone_holder" string="Giá ĐT" readonly="1" width="90px"/>
                                    <field name="qty_charger" string="Sạc xe" readonly="1" width="90px"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-info="state == 'pending'" 
                                           decoration-success="state == 'returned'" 
                                           width="140px"/>
                                    <button name="action_print_receipt" type="object" string="In" icon="fa-print" class="btn btn-sm btn-link text-success" title="In Biên Lai Thu Hồi (PDF)" width="60px"/>
                                </list>
                                <form string="Biên Lai Thu Hồi Xe" create="0" edit="0" delete="0">
                                    <header>
                                        <button name="action_print_receipt" 
                                                type="object" 
                                                string="In Biên Lai (PDF)" 
                                                class="oe_highlight" 
                                                icon="fa-print"/>
                                        <field name="state" widget="statusbar" statusbar_visible="pending,returned" readonly="1"/>
                                    </header>
                                    <sheet>
                                        <field name="ticket_id" invisible="1"/>
                                        <div class="oe_title mb-2">
                                            <label for="name" string="Số Biên Lai Thu Hồi"/>
                                            <h1 class="text-success"><field name="name" readonly="1"/></h1>
                                        </div>
                                        <group>
                                            <group string="Khách hàng bàn giao lại xe">
                                                <field name="customer_id" string="Khách hàng" readonly="1"/>
                                                <field name="customer_phone" string="Số điện thoại" widget="phone" readonly="1"/>
                                            </group>
                                            <group string="Thời gian &amp; Địa điểm thu hồi">
                                                <field name="return_time" string="Giờ thu hồi" readonly="1"/>
                                                <field name="return_date" string="Ngày thu hồi" readonly="1"/>
                                                <field name="return_location" string="Địa điểm thu hồi" readonly="1"/>
                                                <field name="user_id" string="Nhân viên thu hồi xe" readonly="1"/>
                                            </group>
                                        </group>
                                        <div class="o_horizontal_separator text-uppercase fw-bold mt-2 mb-2" style="font-size: 12px; color: #495057;">
                                            <i class="fa fa-cubes me-1"/> Phụ kiện thu hồi thực tế
                                        </div>
                                        <group>
                                            <group>
                                                <field name="qty_helmet" string="Mũ bảo hiểm (cái)" readonly="1"/>
                                                <field name="qty_raincoat" string="Áo mưa (cái)" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="qty_phone_holder" string="Giá đỡ ĐT / Màn hình (cái)" readonly="1"/>
                                                <field name="qty_charger" string="Bộ sạc xe (bộ)" readonly="1"/>
                                            </group>
                                        </group>
                                        <group string="Tình trạng ngoại quan / Hư hại khi nhận lại">
                                            <field name="return_visual_note" string="Ghi chú ngoại quan" readonly="1"/>
                                        </group>
                                        <div class="o_horizontal_separator text-uppercase fw-bold mt-3 mb-2" style="font-size: 12px; color: #495057;">
                                            <i class="fa fa-motorcycle me-1"/> Danh sách xe thu hồi
                                        </div>
                                        <field name="vehicle_ids" readonly="1">
                                            <list create="0" edit="0" delete="0">
                                                <field name="vehicle_id" string="Xe" readonly="1"/>
                                                <field name="license_plate" string="Biển số" readonly="1"/>
                                                <field name="return_date" string="Ngày thu hồi" readonly="1" optional="show"/>
                                                <field name="return_time" string="Giờ thu hồi" readonly="1"/>
                                                <field name="return_location" string="Vị trí thu hồi" readonly="1" optional="show"/>
                                                <field name="return_visual_note" string="Tình trạng ngoại quan khi trả xe" readonly="1"/>
                                                <field name="status" widget="badge" 
                                                       decoration-info="status == 'waiting'" 
                                                       decoration-primary="status == 'delivering'" 
                                                       decoration-warning="status == 'renting'" 
                                                       decoration-success="status == 'returned'" 
                                                       string="Trạng thái xe" readonly="1"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Sự cố &amp; Hư hỏng" name="incidents">
                            <div class="mb-2" invisible="state in ('done', 'contract_cancelled')">
                                <button name="action_bulk_sync_incidents_to_fleet" type="object" string="Lưu thay đổi" class="btn btn-sm btn-primary" icon="fa-save" confirm="Xác nhận lưu thay đổi các sự cố?"/>
                            </div>
                            <field name="incident_ids" readonly="state in ('done', 'contract_cancelled')" context="{'default_ticket_id': id}">
                                <list editable="bottom" delete="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="available_vehicle_ids" column_invisible="1"/>
                                    <field name="needs_repair" column_invisible="1"/>
                                    <field name="name" readonly="1" force_save="1" width="120px"/>
                                    <field name="vehicle_id" options="{'no_create': True, 'no_open': True}" width="160px"/>
                                    <field name="price_catalog_id" options="{'no_create': True, 'no_open': True}" width="180px"/>
                                    <field name="quantity" width="110px" string="Số lượng / Số giờ"/>
                                    <field name="unit" width="80px" readonly="1" force_save="1"/>
                                    <field name="fault_party" width="130px"/>
                                    <field name="needs_repair_display" string="Cần sửa chữa?" width="140px"/>
                                    <field name="status" widget="badge" decoration-warning="status == 'processing'" decoration-success="status == 'resolved'" width="130px" readonly="1" force_save="1"/>
                                    <field name="service_id" column_invisible="1"/>
                                    <field name="damage_description" width="240px"/>
                                    <field name="date_reported" width="160px"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_create_fleet_service" type="object" string="Lưu thay đổi" class="btn-primary" invisible="service_id" confirm="Xác nhận lưu thay đổi các sự cố?"/>
                                        <button name="action_open_fleet_service" type="object" string="Xem phiếu Bảo dưỡng &amp; Sửa chữa" class="btn-secondary" invisible="not service_id"/>
                                        <field name="status" widget="statusbar" statusbar_visible="processing,resolved"/>
                                    </header>
                                    <sheet>
                                        <field name="available_vehicle_ids" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="needs_repair" invisible="1"/>
                                        <group>
                                            <group string="Thông tin xe &amp; thời gian">
                                                <field name="name" readonly="1" force_save="1"/>
                                                <field name="vehicle_id" options="{'no_create': True}"/>
                                                <field name="date_reported"/>
                                            </group>
                                            <group string="Phân loại sự cố &amp; Trách nhiệm">
                                                <field name="fault_party"/>
                                                <field name="price_catalog_id" options="{'no_create': True, 'no_open': True}"/>
                                                <label for="quantity" string="Số lượng / Số giờ"/>
                                                <div class="o_row">
                                                    <field name="quantity" class="oe_inline"/>
                                                    <field name="unit" class="oe_inline ms-2" readonly="1" force_save="1"/>
                                                </div>
                                                <field name="needs_repair_display" string="Cần sửa chữa?"/>
                                                <field name="service_id" readonly="1" invisible="not service_id"/>
                                            </group>
                                        </group>
                                        <group string="Mô tả lỗi / Hư hỏng">
                                            <field name="damage_description" placeholder="Nhập chi tiết lỗi hoặc hư hỏng..."/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Đổi xe" name="vehicle_exchanges">
                            <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
                                <button name="action_select_all_exchanges" type="object" string="Chọn tất cả" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>
                                <button name="action_deselect_all_exchanges" type="object" string="Bỏ chọn" class="btn btn-secondary btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done'"/>


                                <button name="action_bulk_cancel_exchanges" type="object" string="Hủy đổi xe" class="btn btn-danger btn-sm" invisible="state in ('done', 'contract_cancelled') or contract_state == 'done' or not has_selected_exchanges"/>
                            </div>
                            <field name="vehicle_exchange_ids" readonly="state in ('done', 'contract_cancelled')" context="{'default_ticket_id': id}">
                                <list create="0" delete="0">
                                    <field name="is_selected" string="Chọn" width="45px" class="o_ticket_select_checkbox"/>
                                    <field name="name" string="Mã đổi xe" readonly="1" force_save="1" width="130px"/>
                                    <button name="action_open_exchange_detail" type="object" string="Chi tiết" icon="fa-eye" class="btn btn-sm btn-link text-primary" width="90px"/>
                                    <field name="vehicle_a_id" string="Xe hỏng (A)" readonly="1" options="{'no_create': True, 'no_open': True}" width="160px"/>
                                    <field name="vehicle_b_id" string="Xe thay thế (B)" readonly="1" options="{'no_create': True, 'no_open': True}" width="160px"/>
                                    <field name="request_date" string="Thời gian yêu cầu" readonly="1" width="150px"/>
                                    <field name="error_by" string="Lỗi thuộc phía" readonly="status in ('done', 'cancelled')" width="130px"/>
                                    <field name="reason" string="Lý do đổi xe" readonly="status in ('done', 'cancelled')" width="220px"/>
                                    <field name="status" widget="badge" readonly="1"
                                           decoration-info="status == 'confirmed'"
                                           decoration-warning="status == 'in_progress'"
                                           decoration-success="status == 'done'"
                                           decoration-danger="status == 'cancelled'"
                                           width="140px"/>
                                    <field name="available_vehicle_ids" column_invisible="1"/>
                                </list>
                                <form string="Chi Tiết Đổi Xe">
                                    <header>


                                        <button name="action_cancel" type="object" string="Hủy yêu cầu" class="btn-secondary" invisible="status in ('done', 'cancelled')"/>
                                        <field name="status" widget="statusbar" statusbar_visible="confirmed,done" readonly="1"/>
                                    </header>
                                    <sheet>
                                        <field name="available_vehicle_ids" invisible="1"/>
                                        <field name="ticket_id" invisible="1"/>
                                        <div class="oe_title mb-2">
                                            <label for="name" string="Số Phiếu Đổi Xe"/>
                                            <h1 class="text-primary"><field name="name" readonly="1"/></h1>
                                        </div>
                                        <group>
                                            <group string="Thông tin xe đổi">
                                                <field name="vehicle_a_id" string="Xe hỏng (A)" required="1" readonly="status != 'draft'" options="{'no_create': True}"/>
                                                <field name="vehicle_b_id" string="Xe thay thế (B)" required="1" readonly="status != 'draft'" options="{'no_create': True}"/>
                                            </group>
                                            <group string="Chi tiết yêu cầu">
                                                <field name="request_date" string="Thời gian yêu cầu" readonly="1"/>
                                                <field name="error_by" string="Lỗi thuộc phía" readonly="status in ('done', 'cancelled')"/>
                                                <field name="reason" string="Lý do đổi xe" widget="text" readonly="status in ('done', 'cancelled')"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rental_operation_ticket_search" model="ir.ui.view">
        <field name="name">rental.operation.ticket.search</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Phiếu Vận Hành">
                <field name="name"/>
                <field name="rental_order_ref"/>
                <field name="quick_delivery_location" string="Vị trí giao xe"/>
                <field name="customer_id"/>
                <field name="customer_phone"/>
                <filter string="Phiếu vận hành" name="active_operation" domain="[('state', '!=', 'contract_cancelled')]"/>
                <separator/>
                <filter string="Chưa thực hiện" name="waiting" domain="[('state','=','waiting')]"/>
                <filter string="Đang thực hiện" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Hoàn tất" name="done" domain="[('state','=','done')]"/>
                <filter string="Hợp đồng bị hủy" name="contract_cancelled" domain="[('state','=','contract_cancelled')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Khách hàng" name="group_by_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rental_operation_ticket_kanban" model="ir.ui.view">
        <field name="name">rental.operation.ticket.kanban</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" delete="0">
                <field name="id"/>
                <field name="name"/>
                <field name="rental_order_ref"/>
                <field name="customer_id"/>
                <field name="customer_phone"/>
                <field name="state"/>
                <field name="currency_id"/>
                <field name="waiting_count"/>
                <field name="delivering_count"/>
                <field name="renting_count"/>
                <field name="returned_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    Mã Đơn: <field name="rental_order_ref"/>
                                </div>
                                <div>
                                    Khách: <field name="customer_id"/>
                                </div>
                                <div t-if="record.customer_phone.raw_value">
                                    SĐT: <field name="customer_phone"/>
                                </div>
                                <div class="mt-2 text-muted small">
                                    <span>Chờ: <field name="waiting_count"/></span> | 
                                    <span>Giao: <field name="delivering_count"/></span> | 
                                    <span>Thuê: <field name="renting_count"/></span> | 
                                    <span>Thu hồi: <field name="returned_count"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
