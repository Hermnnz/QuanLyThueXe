<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_operation_ticket" model="ir.actions.act_window">
        <field name="name">Phiếu Vận Hành (Giao/Nhận)</field>
        <field name="res_model">rental.operation.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_rental_operation_ticket_tree" model="ir.ui.view">
        <field name="name">rental.operation.ticket.list</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <list string="Phiếu Vận Hành">
                <field name="name"/>
                <field name="rental_order_ref"/>
                <field name="state" widget="badge" decoration-info="state == 'waiting'" decoration-warning="state == 'renting'" decoration-success="state == 'done'"/>
                <field name="total_rent_amount" widget="integer" string="Tổng tiền (000 VNĐ)"/>
                <field name="remaining_cost" widget="integer" string="Còn nợ (000 VNĐ)"/>
            </list>
        </field>
    </record>

    <record id="view_rental_operation_ticket_form" model="ir.ui.view">
        <field name="name">rental.operation.ticket.form</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <form string="Phiếu Vận Hành">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,renting,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" force_save="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rental_order_ref"/>
                            <field name="expected_checkout"/>
                            <field name="rental_duration_days"/>
                            <field name="expected_checkin"/>
                        </group>
                        <group>
                            <label for="total_rent_amount"/>
                            <div class="o_row">
                                <field name="total_rent_amount" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <label for="deposit_amount"/>
                            <div class="o_row">
                                <field name="deposit_amount" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <label for="remaining_rent_amount"/>
                            <div class="o_row">
                                <field name="remaining_rent_amount" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <field name="is_rent_paid"/>
                            <field name="is_id_card_kept"/>
                            
                            <label for="total_incurred_cost" invisible="not is_rent_paid"/>
                            <div class="o_row" invisible="not is_rent_paid">
                                <field name="total_incurred_cost" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <label for="paid_incurred_cost" invisible="not is_rent_paid"/>
                            <div class="o_row" invisible="not is_rent_paid">
                                <field name="paid_incurred_cost" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <label for="remaining_cost" invisible="not is_rent_paid"/>
                            <div class="o_row" invisible="not is_rent_paid">
                                <field name="remaining_cost" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <field name="is_incurred_cost_paid" invisible="not is_rent_paid"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách Xe Giao/Nhận" name="vehicles">
                            <group>
                                <group string="Thiết lập Giao/Nhận">
                                    <field name="quick_delivery_location"/>
                                    <label for="quick_delivery_fee"/>
                                    <div class="o_row">
                                        <field name="quick_delivery_fee" widget="integer" class="oe_inline"/>
                                        <span>000 VNĐ</span>
                                    </div>
                                </group>
                                <group string=" ">
                                    <field name="quick_return_location"/>
                                    <label for="quick_return_fee"/>
                                    <div class="o_row">
                                        <field name="quick_return_fee" widget="integer" class="oe_inline"/>
                                        <span>000 VNĐ</span>
                                    </div>
                                </group>
                            </group>
                            <field name="vehicle_detail_ids" context="{'default_date_checkout': expected_checkout, 'default_date_checkin': expected_checkin, 'default_delivery_location': quick_delivery_location, 'default_delivery_fee': quick_delivery_fee, 'default_return_location': quick_return_location, 'default_return_fee': quick_return_fee}">
                                <list>
                                    <field name="vehicle_id" class="text-start text-left"/>
                                    <field name="vehicle_price" widget="integer" string="Giá xe (000 VNĐ)" class="text-start text-left" width="150px"/>
                                    <field name="delivery_location" optional="show" class="text-start text-left"/>
                                    <field name="delivery_fee" widget="integer" optional="show" class="text-start text-left"/>
                                    <field name="return_location" optional="hide" class="text-start text-left"/>
                                    <field name="return_fee" widget="integer" optional="hide" class="text-start text-left"/>
                                    <field name="date_checkout" class="text-start text-left" width="180px"/>
                                    <field name="date_checkin" class="text-start text-left" width="180px"/>
                                    <field name="status" class="text-start text-left" width="120px"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group string="Thông tin chung">
                                                <field name="vehicle_id"/>
                                                <label for="vehicle_price"/>
                                                <div class="o_row">
                                                    <field name="vehicle_price" widget="integer" class="oe_inline"/>
                                                    <span>000 VNĐ</span>
                                                </div>
                                                <field name="status"/>
                                            </group>
                                            <group string="Lịch trình">
                                                <field name="date_checkout"/>
                                                <field name="date_checkin"/>
                                            </group>
                                        </group>
                                        <group>
                                            <group string="Thông tin Giao Xe">
                                                <field name="delivery_location"/>
                                                <label for="delivery_fee"/>
                                                <div class="o_row">
                                                    <field name="delivery_fee" widget="integer" class="oe_inline"/>
                                                    <span>000 VNĐ</span>
                                                </div>
                                                <field name="is_delivery_fee_paid"/>
                                            </group>
                                            <group string="Thông tin Nhận Xe">
                                                <field name="return_location"/>
                                                <label for="return_fee"/>
                                                <div class="o_row">
                                                    <field name="return_fee" widget="integer" class="oe_inline"/>
                                                    <span>000 VNĐ</span>
                                                </div>
                                                <field name="is_return_fee_paid"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Sự cố &amp; Hư hỏng" name="incidents">
                            <field name="incident_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="vehicle_ref"/>
                                    <field name="timing"/>
                                    <field name="cost" widget="integer" string="Chi phí đền bù (000 VNĐ)"/>
                                    <field name="is_paid"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rental_operation_ticket_search" model="ir.ui.view">
        <field name="name">rental.operation.ticket.search</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Phiếu Vận Hành">
                <field name="name"/>
                <field name="rental_order_ref"/>
                <filter string="Đang chờ Giao" name="waiting" domain="[('state','=','waiting')]"/>
                <filter string="Đang thuê" name="renting" domain="[('state','=','renting')]"/>
                <filter string="Đã hoàn thành" name="done" domain="[('state','=','done')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rental_operation_ticket_kanban" model="ir.ui.view">
        <field name="name">rental.operation.ticket.kanban</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="rental_order_ref"/>
                <field name="state"/>
                <field name="total_rent_amount"/>
                <field name="remaining_cost"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div>
                                Mã Đơn Thuê: <field name="rental_order_ref"/>
                            </div>
                            <div>
                                Tổng tiền: <field name="total_rent_amount"/> 000 VNĐ
                            </div>
                            <div>
                                Còn nợ: <field name="remaining_cost"/> 000 VNĐ
                            </div>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
