<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_operation_ticket" model="ir.actions.act_window">
        <field name="name">Phiếu Vận Hành (Giao/Nhận)</field>
        <field name="res_model">rental.operation.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_rental_operation_ticket_tree" model="ir.ui.view">
        <field name="name">rental.operation.ticket.list</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <list string="Phiếu Vận Hành">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="customer_id"/>
                <field name="rental_order_ref"/>
                <field name="expected_checkout"/>
                <field name="expected_checkin"/>
                <field name="state" widget="badge" decoration-info="state == 'waiting'" decoration-warning="state == 'renting'" decoration-success="state == 'done'"/>
                <field name="total_rent_amount"/>
                <field name="remaining_cost"/>
            </list>
        </field>
    </record>

    <record id="view_rental_operation_ticket_form" model="ir.ui.view">
        <field name="name">rental.operation.ticket.form</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <form string="Phiếu Vận Hành">
                <header>
                    <button name="action_confirm_delivery" 
                            type="object" 
                            string="Xác nhận đã giao xe thành công" 
                            class="oe_highlight" 
                            invisible="state != 'waiting'"
                            confirm="Bạn có chắc chắn muốn xác nhận đã bàn giao xe thành công cho khách hàng?"/>
                    <button name="action_confirm_return" 
                            type="object" 
                            string="Xác nhận hoàn tất trả xe" 
                            class="oe_highlight" 
                            invisible="state != 'renting'"
                            confirm="Bạn có chắc chắn muốn xác nhận hoàn tất thu hồi và nhận xe từ khách hàng?"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,renting,done"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" force_save="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin Hợp đồng &amp; Khách">
                            <field name="contract_id" options="{'no_create': True}" placeholder="Chọn hợp đồng để tự động điền..." readonly="state != 'waiting'"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="rental_order_ref" readonly="1"/>
                        </group>
                        <group string="Thời gian thuê">
                            <field name="expected_checkout" readonly="1"/>
                            <field name="rental_duration_days" readonly="1"/>
                            <field name="expected_checkin" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tiền thuê &amp; Cọc">
                            <field name="total_rent_amount" readonly="1"/>
                            <field name="deposit_amount" readonly="1"/>
                            <field name="remaining_rent_amount" readonly="1"/>
                        </group>
                        <group string="Chi phí phát sinh" invisible="state == 'waiting'">
                            <field name="total_incurred_cost"/>
                            <field name="paid_incurred_cost"/>
                            <field name="remaining_cost"/>
                            <field name="is_incurred_cost_paid"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách Xe Giao/Nhận" name="vehicles">
                            <group>
                                <group string="Thiết lập Giao/Nhận">
                                    <field name="quick_delivery_location"/>
                                    <field name="quick_delivery_fee"/>
                                </group>
                                <group string=" ">
                                    <field name="quick_return_location"/>
                                    <field name="quick_return_fee"/>
                                </group>
                            </group>
                            <field name="vehicle_detail_ids" context="{'default_date_checkout': expected_checkout, 'default_date_checkin': expected_checkin, 'default_delivery_location': quick_delivery_location, 'default_delivery_fee': quick_delivery_fee, 'default_return_location': quick_return_location, 'default_return_fee': quick_return_fee}">
                                <list create="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="vehicle_id" readonly="1" force_save="1" class="text-start text-left"/>
                                    <field name="vehicle_price" readonly="1" force_save="1" class="text-start text-left" width="150px"/>
                                    <field name="delivery_location" optional="show" class="text-start text-left"/>
                                    <field name="delivery_fee" optional="show" class="text-start text-left"/>
                                    <field name="return_location" optional="hide" class="text-start text-left"/>
                                    <field name="return_fee" optional="hide" class="text-start text-left"/>
                                    <field name="date_checkout" readonly="1" force_save="1" class="text-start text-left" width="180px"/>
                                    <field name="date_checkin" readonly="1" force_save="1" class="text-start text-left" width="180px"/>
                                    <field name="status" class="text-start text-left" width="120px"/>
                                </list>
                                <form>
                                    <sheet>
                                        <field name="currency_id" invisible="1"/>
                                        <group>
                                            <group string="Thông tin chung">
                                                <field name="vehicle_id" readonly="1" force_save="1"/>
                                                <field name="vehicle_price" readonly="1" force_save="1"/>
                                                <field name="status"/>
                                            </group>
                                            <group string="Lịch trình">
                                                <field name="date_checkout" readonly="1" force_save="1"/>
                                                <field name="date_checkin" readonly="1" force_save="1"/>
                                            </group>
                                        </group>
                                        <group>
                                            <group string="Thông tin Giao Xe">
                                                <field name="delivery_location"/>
                                                <field name="delivery_fee"/>
                                                <field name="is_delivery_fee_paid"/>
                                            </group>
                                            <group string="Thông tin Nhận Xe">
                                                <field name="return_location"/>
                                                <field name="return_fee"/>
                                                <field name="is_return_fee_paid"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Sự cố &amp; Hư hỏng" name="incidents">
                            <field name="incident_ids" readonly="1">
                                <list>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="vehicle_ref"/>
                                    <field name="timing"/>
                                    <field name="cost"/>
                                    <field name="is_paid"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rental_operation_ticket_search" model="ir.ui.view">
        <field name="name">rental.operation.ticket.search</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Phiếu Vận Hành">
                <field name="name"/>
                <field name="rental_order_ref"/>
                <filter string="Đang chờ Giao" name="waiting" domain="[('state','=','waiting')]"/>
                <filter string="Đang thuê" name="renting" domain="[('state','=','renting')]"/>
                <filter string="Đã hoàn thành" name="done" domain="[('state','=','done')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rental_operation_ticket_kanban" model="ir.ui.view">
        <field name="name">rental.operation.ticket.kanban</field>
        <field name="model">rental.operation.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="rental_order_ref"/>
                <field name="state"/>
                <field name="currency_id"/>
                <field name="total_rent_amount"/>
                <field name="remaining_cost"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div>
                                Mã Đơn Thuê: <field name="rental_order_ref"/>
                            </div>
                            <div>
                                Tổng tiền: <field name="total_rent_amount"/>
                            </div>
                            <div>
                                Còn nợ: <field name="remaining_cost"/>
                            </div>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
