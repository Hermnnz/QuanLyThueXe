<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_incident_log" model="ir.actions.act_window">
        <field name="name">Sự cố &amp; Hư hỏng</field>
        <field name="res_model">rental.operation.incident.log</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_rental_incident_log_tree" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.list</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <list string="Sự cố" class="o_rental_incident_list_table" delete="false">
                <field name="currency_id" column_invisible="1"/>
                <field name="name" width="130px"/>
                <field name="ticket_id" width="160px"/>
                <field name="vehicle_id" width="180px"/>
                <field name="price_catalog_id" width="200px"/>
                <field name="quantity" width="110px" string="Số lượng / Số giờ"/>
                <field name="unit" width="80px"/>
                <field name="fault_party" width="150px"/>
                <field name="needs_repair_display" string="Cần sửa chữa?" width="150px"/>
                <field name="service_id" column_invisible="1"/>
                <field name="damage_description" width="280px"/>
                <field name="date_reported" width="175px"/>
            </list>
        </field>
    </record>

    <record id="view_rental_incident_log_form" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.form</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <form string="Sự cố" options="{'no_delete': True}">
                <header>
                    <button name="action_create_fleet_service" type="object" string="Đồng bộ dữ liệu" class="btn-primary" invisible="service_id"/>
                    <button name="action_open_fleet_service" type="object" string="Xem phiếu Bảo dưỡng &amp; Sửa chữa" class="btn-secondary" invisible="not service_id"/>
                    <button name="action_start_processing" type="object" string="Bắt đầu xử lý" class="btn-outline-primary" invisible="status != 'new'"/>
                    <button name="action_resolve" type="object" string="Hoàn tất xử lý" class="btn-success" invisible="status != 'processing'"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,processing,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" force_save="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin xe &amp; thời gian">
                            <field name="available_vehicle_ids" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="ticket_id"/>
                            <field name="vehicle_id"/>
                            <field name="date_reported"/>
                        </group>
                        <group string="Phân loại sự cố &amp; Trách nhiệm">
                            <field name="fault_party"/>
                            <field name="price_catalog_id" options="{'no_create': True, 'no_open': True}"/>
                            <label for="quantity" string="Số lượng / Số giờ"/>
                            <div class="o_row">
                                <field name="quantity" class="oe_inline"/>
                                <field name="unit" class="oe_inline ms-2" readonly="1" force_save="1"/>
                            </div>
                            <field name="needs_repair_display" string="Cần sửa chữa?"/>
                            <field name="service_id" readonly="1" invisible="not service_id"/>
                        </group>
                    </group>
                    <group string="Mô tả lỗi / Hư hỏng">
                        <field name="damage_description" nolabel="1" placeholder="Nhập mô tả chi tiết lỗi hoặc hư hỏng của xe..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_incident_log_search" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.search</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Sự cố">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="ticket_id"/>
                <field name="fault_party"/>
                <filter string="Cần sửa chữa" name="needs_repair" domain="[('needs_repair','=',True)]"/>
                <filter string="Không cần sửa chữa" name="no_needs_repair" domain="[('needs_repair','=',False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Cần sửa chữa" name="group_by_needs_repair" context="{'group_by':'needs_repair'}"/>
                    <filter string="Lỗi thuộc về" name="group_by_fault_party" context="{'group_by':'fault_party'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rental_incident_log_kanban" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.kanban</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="needs_repair" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="ticket_id"/>
                <field name="fault_party"/>
                <field name="needs_repair"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    Xe: <field name="vehicle_id"/>
                                </div>
                                <div>
                                    Phiếu: <field name="ticket_id"/>
                                </div>
                                <div>
                                    Lỗi thuộc về: <field name="fault_party"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
