<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_rental_incident_log" model="ir.actions.act_window">
        <field name="name">Sự cố &amp; Hư hỏng</field>
        <field name="res_model">rental.operation.incident.log</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="view_rental_incident_log_tree" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.tree</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <tree string="Sự cố">
                <field name="name"/>
                <field name="ticket_id"/>
                <field name="vehicle_ref"/>
                <field name="timing"/>
                <field name="date_reported"/>
                <field name="cost" widget="integer" string="Chi phí (000 VNĐ)"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_incident_log_form" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.form</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <form string="Sự cố">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="new,processing,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" force_save="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="vehicle_ref"/>
                            <field name="timing"/>
                            <field name="date_reported"/>
                        </group>
                        <group>
                            <field name="fault_party"/>
                            <field name="customer_decision"/>
                            <label for="cost"/>
                            <div class="o_row">
                                <field name="cost" widget="integer" class="oe_inline"/>
                                <span>000 VNĐ</span>
                            </div>
                            <field name="is_paid"/>
                        </group>
                    </group>
                    <group string="Mô tả lỗi / Hư hỏng">
                        <field name="damage_description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_vehicle_replacement" model="ir.actions.act_window">
        <field name="name">Yêu cầu Đổi xe</field>
        <field name="res_model">rental.operation.vehicle.replacement</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="view_rental_vehicle_replacement_tree" model="ir.ui.view">
        <field name="name">rental.operation.vehicle.replacement.tree</field>
        <field name="model">rental.operation.vehicle.replacement</field>
        <field name="arch" type="xml">
            <tree string="Đổi xe">
                <field name="name"/>
                <field name="incident_id"/>
                <field name="old_vehicle_ref"/>
                <field name="new_vehicle_ref"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_vehicle_replacement_form" model="ir.ui.view">
        <field name="name">rental.operation.vehicle.replacement.form</field>
        <field name="model">rental.operation.vehicle.replacement</field>
        <field name="arch" type="xml">
            <form string="Đổi xe">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" force_save="1"/></h1>
                    </div>
                    <group>
                        <field name="incident_id"/>
                        <field name="old_vehicle_ref"/>
                        <field name="new_vehicle_ref"/>
                        <field name="date_replaced"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rental_incident_log_search" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.search</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Sự cố">
                <field name="name"/>
                <field name="vehicle_ref"/>
                <field name="ticket_id"/>
                <filter string="Mới" name="new" domain="[('status','=','new')]"/>
                <filter string="Đang xử lý" name="processing" domain="[('status','=','processing')]"/>
                <filter string="Đã giải quyết" name="resolved" domain="[('status','=','resolved')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_by_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rental_incident_log_kanban" model="ir.ui.view">
        <field name="name">rental.operation.incident.log.kanban</field>
        <field name="model">rental.operation.incident.log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="vehicle_ref"/>
                <field name="ticket_id"/>
                <field name="status"/>
                <field name="cost"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div>
                                Xe: <field name="vehicle_ref"/>
                            </div>
                            <div>
                                Phiếu: <field name="ticket_id"/>
                            </div>
                            <div>
                                Chi phí: <field name="cost"/> 000 VNĐ
                            </div>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rental_vehicle_replacement_search" model="ir.ui.view">
        <field name="name">rental.operation.vehicle.replacement.search</field>
        <field name="model">rental.operation.vehicle.replacement</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Đổi xe">
                <field name="name"/>
                <field name="old_vehicle_ref"/>
                <field name="new_vehicle_ref"/>
                <filter string="Nháp" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Hoàn thành" name="done" domain="[('state','=','done')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rental_vehicle_replacement_kanban" model="ir.ui.view">
        <field name="name">rental.operation.vehicle.replacement.kanban</field>
        <field name="model">rental.operation.vehicle.replacement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="incident_id"/>
                <field name="old_vehicle_ref"/>
                <field name="new_vehicle_ref"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div>
                                Xe cũ: <field name="old_vehicle_ref"/>
                            </div>
                            <div>
                                Xe mới: <field name="new_vehicle_ref"/>
                            </div>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
