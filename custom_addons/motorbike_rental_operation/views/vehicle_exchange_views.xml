<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Vehicle Exchange -->
    <record id="action_rental_vehicle_exchange" model="ir.actions.act_window">
        <field name="name">Đổi Xe</field>
        <field name="res_model">rental.vehicle.exchange</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_help">Tạo một bản ghi đổi xe mới.</p>
        </field>
    </record>

    <!-- Menu item under Vận Hành Thuê Xe -->
    <menuitem id="menu_rental_vehicle_exchange"
              name="Đổi Xe"
              parent="menu_rental_operation_root"
              sequence="25"
              action="action_rental_vehicle_exchange"/>

    <!-- List view -->
    <record id="view_rental_vehicle_exchange_tree" model="ir.ui.view">
        <field name="name">rental.vehicle.exchange.list</field>
        <field name="model">rental.vehicle.exchange</field>
        <field name="arch" type="xml">
            <list string="Đổi Xe">
                <header>
                    <button name="action_cancel" type="object" string="Hủy yêu cầu" class="btn-danger"/>
                </header>
                <field name="is_selected" string="Chọn" width="45px"/>
                <field name="name" string="Mã đổi xe" width="130px"/>
                <field name="ticket_id" string="Phiếu vận hành" width="160px"/>
                <field name="vehicle_a_id" string="Xe hỏng (A)" width="160px"/>
                <field name="vehicle_b_id" string="Xe thay thế (B)" width="160px"/>
                <field name="status" widget="badge" readonly="1"
                       decoration-info="status == 'confirmed'"
                       decoration-success="status == 'done'"
                       decoration-danger="status == 'cancelled'"
                       width="140px"/>
                <field name="request_date" string="Thời gian yêu cầu" width="150px"/>
                <field name="error_by" string="Lỗi thuộc phía" width="130px"/>
                <field name="reason" string="Lý do đổi xe" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_rental_vehicle_exchange_form" model="ir.ui.view">
        <field name="name">rental.vehicle.exchange.form</field>
        <field name="model">rental.vehicle.exchange</field>
        <field name="arch" type="xml">
            <form string="Chi Tiết Đổi Xe">
                <header>
                    <button name="action_cancel" type="object" string="Hủy yêu cầu" class="btn-secondary" invisible="status in ('done', 'cancelled')"/>
                    <field name="status" widget="statusbar" statusbar_visible="confirmed,done" readonly="1"/>
                </header>
                <sheet>
                    <field name="available_vehicle_ids" invisible="1"/>
                    <field name="vehicle_a_model_id" invisible="1"/>
                    <div class="oe_title mb-2">
                        <label for="name" string="Số Phiếu Đổi Xe"/>
                        <h1 class="text-primary"><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin xe đổi">
                            <field name="vehicle_a_id" string="Xe hỏng (A)" required="1" readonly="id" options="{'no_create': True}"/>
                            <field name="vehicle_b_id" string="Xe thay thế (B)" required="1" readonly="id" domain="[('operational_status', '=', 'available'), ('model_id', '=', vehicle_a_model_id)]" options="{'no_create': True}"/>
                        </group>
                        <group string="Chi tiết yêu cầu">
                            <field name="ticket_id" string="Phiếu vận hành" readonly="status != 'confirmed'"/>
                            <field name="request_date" string="Thời gian yêu cầu" readonly="1"/>
                            <field name="error_by" string="Lỗi thuộc phía" readonly="status in ('done', 'cancelled')"/>
                            <field name="reason" string="Lý do đổi xe" widget="text" readonly="status in ('done', 'cancelled')"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
