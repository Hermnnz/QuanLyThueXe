                                <h5 class="text-primary fw-bold mb-1">
                                    <field name="receipt_1_name" readonly="1"/>
                                </h5>
                            </div>
                            <group>
                                <group string="Khách hàng nhận xe">
                                    <field name="receipt_1_customer_id" string="Khách hàng"/>
                                    <field name="receipt_1_customer_phone" string="Số điện thoại" widget="phone"/>
                                </group>
                                <group string="Thời gian &amp; Địa điểm giao">
                                    <field name="receipt_1_delivery_time" string="Giờ giao xe"/>
                                    <field name="receipt_1_delivery_date" string="Ngày giao xe"/>
                                    <field name="receipt_1_delivery_location" string="Địa điểm giao xe"/>
                                </group>
                            </group>

                            <div class="o_horizontal_separator text-uppercase fw-bold mt-2 mb-2" style="font-size: 12px; color: #495057;">
                                <i class="fa fa-cubes me-1"/> Phụ kiện kèm theo (Bàn giao theo nhóm xe)
                            </div>
                            <group>
                                <group>
                                    <field name="receipt_1_qty_helmet" string="Mũ bảo hiểm (cái)"/>
                                    <field name="receipt_1_qty_raincoat" string="Áo mưa (cái)"/>
                                </group>
                                <group>
                                    <field name="receipt_1_qty_phone_holder" string="Giá đỡ ĐT / Màn hình (cái)"/>
                                    <field name="receipt_1_qty_charger" string="Bộ sạc xe (bộ)"/>
                                </group>
                            </group>

                            <div class="o_horizontal_separator text-uppercase fw-bold mt-3 mb-2" style="font-size: 12px; color: #495057;">
                                <i class="fa fa-motorcycle me-1"/> Thông tin xe &amp; Tình trạng ngoại quan ban đầu
                            </div>
                            <field name="receipt_1_vehicle_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="vehicle_id" string="Xe" readonly="1"/>
                                    <field name="license_plate" string="Biển số" readonly="1"/>
                                    <field name="delivery_time" string="Giờ giao" readonly="1"/>
                                    <field name="delivery_location" string="Vị trí giao" readonly="1" optional="show"/>
                                    <field name="delivery_visual_note" string="Tình trạng ngoại quan ban đầu (vết xước, phụ kiện...)"/>
