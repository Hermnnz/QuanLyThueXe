                                    <field name="license_plate" string="Biển số" readonly="1"/>
                                    <field name="return_time" string="Giờ thu hồi" readonly="1"/>
                                    <field name="return_location" string="Vị trí thu hồi" readonly="1" optional="show"/>
                                    <field name="return_visual_note" string="Tình trạng xe khi nhận lại" readonly="parent.receipt_6_state == 'returned'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_confirm_only" 
                            type="object" 
                            string="Cập nhật biên lai" 
                            class="btn-primary" 
                            icon="fa-save"/>
                    <button name="action_confirm_and_print" 
                            type="object" 
                            string="Cập nhật và xuất biên lai" 
                            class="btn-secondary" 
                            icon="fa-print"/>
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
