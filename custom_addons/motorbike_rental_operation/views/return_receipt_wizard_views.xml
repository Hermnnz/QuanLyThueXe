        <field name="model">rental.return.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Xác Nhận &amp; Xuất Biên Lai Thu Hồi Xe">
                <sheet>
                    <field name="ticket_id" invisible="1"/>
                    <field name="receipt_1_visible" invisible="1"/>
                    <field name="receipt_2_visible" invisible="1"/>
                    <field name="receipt_3_visible" invisible="1"/>
                    <field name="receipt_4_visible" invisible="1"/>
                    <field name="receipt_5_visible" invisible="1"/>
                    <field name="receipt_6_visible" invisible="1"/>

                    <field name="receipt_1_receipt_id" invisible="1"/>
                    <field name="receipt_2_receipt_id" invisible="1"/>
                    <field name="receipt_3_receipt_id" invisible="1"/>
                    <field name="receipt_4_receipt_id" invisible="1"/>
                    <field name="receipt_5_receipt_id" invisible="1"/>
                    <field name="receipt_6_receipt_id" invisible="1"/>

                    <notebook>
                        <!-- TAB BIÊN LAI 1 -->
                        <page string="Biên lai 1" name="tab_receipt_1" invisible="not receipt_1_visible">
                            <field name="receipt_1_state" invisible="1"/>
                            <div class="alert alert-warning py-1 mb-2 d-flex align-items-center" invisible="receipt_1_state != 'returned'" role="alert">
                                <i class="fa fa-lock fa-lg me-2 text-warning"/>
                                <div>
                                    <strong>Biên lai này đã thu hồi hoàn tất!</strong> Thông tin biên lai được giữ nguyên (không cho phép sửa đổi).
                                </div>
                            </div>
                            <div class="mb-2">
                                <h5 class="text-success fw-bold mb-1">
                                    <field name="receipt_1_name" readonly="1"/>
                                </h5>
                            </div>
                            <group>
                                <group string="Khách hàng bàn giao lại xe">
                                    <field name="receipt_1_customer_id" string="Khách hàng" readonly="receipt_1_state == 'returned'"/>
                                    <field name="receipt_1_customer_phone" string="Số điện thoại" widget="phone" readonly="receipt_1_state == 'returned'"/>
                                </group>
                                <group string="Thời gian &amp; Địa điểm thu hồi">
                                    <field name="receipt_1_return_time" string="Giờ thu hồi xe" readonly="receipt_1_state == 'returned'"/>
                                    <field name="receipt_1_return_date" string="Ngày thu hồi xe" readonly="receipt_1_state == 'returned'"/>
                                    <field name="receipt_1_return_location" string="Địa điểm thu hồi xe" readonly="receipt_1_state == 'returned'"/>
                                </group>
                            </group>

                            <div class="o_horizontal_separator text-uppercase fw-bold mt-2 mb-2" style="font-size: 12px; color: #495057;">
                                <i class="fa fa-cubes me-1"/> Phụ kiện thu hồi thực tế
                            </div>
                            <group>
                                <group>
                                    <field name="receipt_1_qty_helmet" string="Mũ bảo hiểm (cái)" readonly="receipt_1_state == 'returned'"/>
                                    <field name="receipt_1_qty_raincoat" string="Áo mưa (cái)" readonly="receipt_1_state == 'returned'"/>
                                </group>
                                <group>
                                    <field name="receipt_1_qty_phone_holder" string="Giá đỡ ĐT / Màn hình (cái)" readonly="receipt_1_state == 'returned'"/>
                                    <field name="receipt_1_qty_charger" string="Bộ sạc xe (bộ)" readonly="receipt_1_state == 'returned'"/>
                                </group>
                            </group>

                            <group string="Tình trạng ngoại quan / Hư hại khi nhận lại">
                                <field name="receipt_1_return_visual_note" string="Ghi chú ngoại quan" readonly="receipt_1_state == 'returned'"/>
                            </group>

                            <div class="o_horizontal_separator text-uppercase fw-bold mt-3 mb-2" style="font-size: 12px; color: #495057;">
                                <i class="fa fa-motorcycle me-1"/> Danh sách xe thu hồi &amp; Tình trạng xe
                            </div>
                            <field name="receipt_1_vehicle_ids" readonly="receipt_1_state == 'returned'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="vehicle_id" string="Xe" readonly="1"/>
                                    <field name="license_plate" string="Biển số" readonly="1"/>
                                    <field name="return_time" string="Giờ thu hồi" readonly="1"/>
                                    <field name="return_location" string="Vị trí thu hồi" readonly="1" optional="show"/>
                                    <field name="return_visual_note" string="Tình trạng xe khi nhận lại" readonly="parent.receipt_1_state == 'returned'"/>
                                </list>
                            </field>
