<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Sequence for Phiếu Vận Hành -->
        <record id="seq_rental_operation_ticket" model="ir.sequence">
            <field name="name">Mã Phiếu Vận Hành</field>
            <field name="code">rental.operation.ticket</field>
            <field name="prefix">OP-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Sự cố &amp; Hư hỏng -->
        <record id="seq_rental_incident_log" model="ir.sequence">
            <field name="name">Mã sự cố</field>
            <field name="code">rental.operation.incident.log</field>
            <field name="prefix">INC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Bảng giá Sự cố (Mã sự cố tự động) -->
        <record id="seq_motorbike_rental_price_catalog" model="ir.sequence">
            <field name="name">Mã sự cố Bảng giá</field>
            <field name="code">motorbike.rental.price.catalog.incident</field>
            <field name="prefix">SC-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Biên Lai Giao Xe -->
        <record id="seq_rental_delivery_receipt" model="ir.sequence">
            <field name="name">Mã Biên Lai Giao Xe</field>
            <field name="code">rental.delivery.receipt</field>
            <field name="prefix">BLGX-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Biên Lai Thu Hồi Xe -->
        <record id="seq_rental_return_receipt" model="ir.sequence">
            <field name="name">Mã Biên Lai Thu Hồi Xe</field>
            <field name="code">rental.return.receipt</field>
            <field name="prefix">BLTH-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
