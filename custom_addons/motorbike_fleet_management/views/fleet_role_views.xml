<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="service_complete_wizard_form" model="ir.ui.view">
    <field name="name">motorbike.service.complete.wizard.form</field>
    <field name="model">motorbike.service.complete.wizard</field>
    <field name="arch" type="xml">
      <form string="Hoàn tất bảo dưỡng">
        <group><field name="service_id" options="{'no_open': True}"/><field name="result"/></group>
        <footer><button name="action_complete" type="object" string="Xác nhận hoàn tất" class="btn-primary"/>
          <button string="Đóng" special="cancel" class="btn-secondary"/></footer>
      </form>
    </field>
  </record>
</odoo>
