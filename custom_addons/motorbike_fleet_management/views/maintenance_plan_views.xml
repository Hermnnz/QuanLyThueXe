<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="maintenance_plan_list" model="ir.ui.view">
    <field name="name">maintenance_plan_list</field>
    <field name="model">motorbike.maintenance.plan</field>
    <field name="arch" type="xml">
      <list>
        <field name="vehicle_id"/>
        <field name="name"/>
        <field name="interval_km"/>
        <field name="interval_days"/>
        <field name="next_service_odo"/>
        <field name="next_service_date"/>
      </list>
    </field>
  </record>
  <record id="maintenance_plan_form" model="ir.ui.view">
    <field name="name">maintenance_plan_form</field>
    <field name="model">motorbike.maintenance.plan</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="vehicle_id"/>
            <field name="service_type_id"/>
            <field name="active"/>
          </group>
          <group>
            <group string="Chu kỳ">
              <field name="interval_km"/>
              <field name="interval_days"/>
              <field name="warning_km"/>
              <field name="warning_days"/>
            </group>
            <group string="Mốc bảo dưỡng (nhập tay tuần 6)">
              <field name="last_service_odo"/>
              <field name="last_service_date"/>
              <field name="next_service_odo"/>
              <field name="next_service_date"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_maintenance_plans" model="ir.actions.act_window">
    <field name="name">Kế hoạch bảo dưỡng</field>
    <field name="res_model">motorbike.maintenance.plan</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_maintenance_plans" name="Kế hoạch bảo dưỡng" parent="fleet.fleet_configuration" action="action_maintenance_plans" groups="fleet.fleet_group_manager"/>
</odoo>
