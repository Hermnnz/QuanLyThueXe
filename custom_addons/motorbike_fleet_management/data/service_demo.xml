<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- ========================================================================= -->
    <!-- PHIẾU DỊCH VỤ & BẢO DƯỠNG MẪU (FLEET SERVICE LOGS)                         -->
    <!-- Đồng bộ 100% với danh mục xe máy điện tại vehicle_demo.xml                -->
    <!-- Đa dạng trạng thái: done (Hoàn thành), running (Đang làm), new (Mới tạo),  -->
    <!-- cancelled (Đã hủy) và đầy đủ loại hình: preventive, corrective, emergency -->
    <!-- ========================================================================= -->

    <!-- Phiếu 01: Bảo dưỡng định kỳ 1.000 km - ĐÃ HOÀN THÀNH -->
    <record id="demo_service_01_done" model="fleet.vehicle.log.services">
      <field name="vehicle_id" ref="demo_vehicle_evo_01" />
      <field name="service_type_id" ref="service_type_electric_maintenance" />
      <field name="maintenance_type">preventive</field>
      <field name="state">done</field>
      <field name="date">2026-03-20</field>
      <field name="actual_start">2026-03-20 08:30:00</field>
      <field name="actual_end">2026-03-20 10:30:00</field>
      <field name="service_odometer">1000.0</field>
      <field name="service_odometer_recorded" eval="True" />
      <field name="amount">150000.0</field>
      <field name="description">Bảo dưỡng định kỳ mốc 1.000 km: kiểm tra phanh đĩa, bôi trơn dây ga, siết ốc liên kết và kiểm tra dung lượng pin LFP.</field>
      <field name="result">Đã hoàn thành bảo dưỡng mốc 1.000 km. Điện áp pin và độ dày má phanh đều đạt tiêu chuẩn an toàn bàn giao.</field>
    </record>

    <!-- Phiếu 02: Sửa chữa thay má phanh & kiểm tra sạc - ĐANG THỰC HIỆN (Khớp xe XE00007 đang maintenance) -->
    <record id="demo_service_02_running" model="fleet.vehicle.log.services">
      <field name="vehicle_id" ref="demo_vehicle_feliz_07" />
      <field name="service_type_id" ref="service_type_electric_maintenance" />
      <field name="maintenance_type">corrective</field>
      <field name="state">running</field>
      <field name="date">2026-04-18</field>
      <field name="actual_start">2026-04-18 09:00:00</field>
      <field name="amount">320000.0</field>
      <field name="description">Khắc phục phanh sau kêu ken két: thay má phanh gốm mới, tra mỡ cổ phốt và vệ sinh jack cắm sạc pin.</field>
    </record>

    <!-- Phiếu 03: Đặt lịch bảo dưỡng định kỳ mốc 2.500 km - MỚI TẠO (Dự phòng cho xe XE00003 sắp tới hạn) -->
    <record id="demo_service_03_new" model="fleet.vehicle.log.services">
      <field name="vehicle_id" ref="demo_vehicle_weaver_03" />
      <field name="service_type_id" ref="service_type_electric_maintenance" />
      <field name="maintenance_type">preventive</field>
      <field name="state">new</field>
      <field name="date">2026-04-20</field>
      <field name="amount">200000.0</field>
      <field name="description">Đặt lịch bảo dưỡng dự phòng mốc 2.500 km: kiểm tra độ chùng xích tải Dat Bike, cân vành và kiểm tra cell pin.</field>
    </record>

    <!-- Phiếu 04: Thay lốp định kỳ sau thời gian khai thác - ĐÃ HOÀN THÀNH -->
    <record id="demo_service_04_done" model="fleet.vehicle.log.services">
      <field name="vehicle_id" ref="demo_vehicle_evo_06" />
      <field name="service_type_id" ref="service_type_electric_maintenance" />
      <field name="maintenance_type">corrective</field>
      <field name="state">done</field>
      <field name="date">2026-02-10</field>
      <field name="actual_start">2026-02-10 14:00:00</field>
      <field name="actual_end">2026-02-10 16:30:00</field>
      <field name="service_odometer">2000.0</field>
      <field name="service_odometer_recorded" eval="True" />
      <field name="amount">250000.0</field>
      <field name="description">Thay cặp lốp không săm Maxxis sau 2.000 km khai thác và cân chỉnh lại tay phanh trái.</field>
      <field name="result">Đã thay lốp mới, áp suất trước 2.0 bar, sau 2.3 bar. Vận hành thử trên đường êm ái, phanh bám đường tốt.</field>
    </record>

    <!-- Phiếu 05: Kiểm tra nguồn sạc trạm ngoài - ĐÃ HỦY (Do sự cố trạm điện, xe không lỗi) -->
    <record id="demo_service_05_cancelled" model="fleet.vehicle.log.services">
      <field name="vehicle_id" ref="demo_vehicle_klara_04" />
      <field name="service_type_id" ref="service_type_electric_maintenance" />
      <field name="maintenance_type">emergency</field>
      <field name="state">cancelled</field>
      <field name="date">2026-04-05</field>
      <field name="amount">0.0</field>
      <field name="description">Khách báo xe sạc chậm tại trạm ngoài; kỹ thuật viên kiểm tra nguồn điện trạm yếu, bộ sạc và pin xe hoạt động bình thường nên hủy phiếu sửa chữa.</field>
    </record>

  </data>
</odoo>
