    <record id="demo_vehicle_evo_01" model="fleet.vehicle">
      <field name="model_id" ref="model_vinfast_evo200" />
      <field name="license_plate">59-MD1 068.11</field>
      <field name="is_electric_motorbike" eval="True" />
      <field name="fuel_type">electric</field>
      <field name="color">Đỏ đô</field>
      <field name="acquisition_date">2026-01-10</field>
      <field name="odometer">1250.0</field>
      <field name="operational_status">available</field>
      <field name="technical_ready" eval="True" />
      <field name="service_interval_km">2000</field>
      <field name="service_interval_months">3</field>
      <field name="service_warning_km">200</field>
      <field name="service_warning_days">7</field>
      <field name="service_reference_date">2026-01-10</field>
      <field name="service_reference_odo">0.0</field>
