<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- ========================================== -->
    <!-- 1. DANH MỤC HÃNG XE (BRANDS)               -->
    <!-- ========================================== -->
    <record id="brand_vinfast" model="fleet.vehicle.model.brand">
      <field name="name">VinFast</field>
      <field name="active" eval="True" />
    </record>

    <record id="brand_datbike" model="fleet.vehicle.model.brand">
      <field name="name">Dat Bike</field>
      <field name="active" eval="True" />
    </record>

    <!-- ========================================== -->
    <!-- 2. DANH MỤC DÒNG XE MÁY ĐIỆN (MODELS)      -->
    <!-- ========================================== -->
    <record id="model_vinfast_evo200" model="fleet.vehicle.model">
      <field name="name">Evo200</field>
      <field name="brand_id" ref="brand_vinfast" />
      <field name="vehicle_type">bike</field>
      <field name="active" eval="True" />
    </record>

    <record id="model_vinfast_feliz_s" model="fleet.vehicle.model">
      <field name="name">Feliz S</field>
      <field name="brand_id" ref="brand_vinfast" />
      <field name="vehicle_type">bike</field>
      <field name="active" eval="True" />
    </record>

    <record id="model_vinfast_klara_s" model="fleet.vehicle.model">
      <field name="name">Klara S (2022)</field>
      <field name="brand_id" ref="brand_vinfast" />
      <field name="vehicle_type">bike</field>
      <field name="active" eval="True" />
    </record>

    <record id="model_datbike_weaver_pp" model="fleet.vehicle.model">
      <field name="name">Weaver++</field>
      <field name="brand_id" ref="brand_datbike" />
      <field name="vehicle_type">bike</field>
      <field name="active" eval="True" />
