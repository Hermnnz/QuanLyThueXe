<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rental_contract_list" model="ir.ui.view">
        <field name="name">rental.contract.list</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <list string="Hợp đồng thuê xe" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rental_days"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">rental.contract.form</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng thuê xe">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Bắt đầu thuê" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Hoàn tất" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Hủy" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done,cancelled" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã hợp đồng"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin thuê">
                            <field name="customer_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="min_rental_days"/>
                            <field name="max_rental_days"/>
                        </group>
                        <group string="Chi phí">
                            <field name="currency_id" invisible="1"/>
                            <field name="rental_days"/>
                            <field name="deposit_amount"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group string="Xe thuê">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="vehicle_id" string="ID xe bên Quản lý xe"/>
                                <field name="vehicle_type_id" domain="[('active', '=', True), ('currency_id', '=', parent.currency_id)]"/>
                                <field name="daily_rate" readonly="1"/>
                                <field name="subtotal" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="notes" placeholder="Ghi chú cho hợp đồng..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_contract_search" model="ir.ui.view">
        <field name="name">rental.contract.search</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <search string="Tìm hợp đồng thuê xe">
                <field name="name"/>
                <field name="customer_id"/>
                <filter name="draft" string="Nháp" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Đã xác nhận" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_progress" string="Đang thuê" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Hoàn tất" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Đã hủy" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_state" string="Nhóm theo trạng thái" context="{'group_by': 'state'}"/>
                <filter name="group_customer" string="Nhóm theo khách hàng" context="{'group_by': 'customer_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_rental_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng thuê xe</field>
        <field name="res_model">rental.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_contract_search"/>
    </record>

    <menuitem id="menu_motorbike_rental_root" name="Motorbike Rental" sequence="35" groups="motorbike_rental_core.group_rental_user"/>
    <menuitem id="menu_rental_management" name="Quản lý thuê xe" parent="menu_motorbike_rental_root" sequence="10"/>
    <menuitem id="menu_rental_contract" name="Hợp đồng thuê xe" parent="menu_rental_management" action="action_rental_contract" sequence="10"/>
    <menuitem id="menu_rental_configuration" name="Cấu hình" parent="menu_motorbike_rental_root" sequence="90" groups="motorbike_rental_core.group_rental_manager"/>
    <menuitem id="menu_rental_vehicle_type" name="Bảng giá thuê theo dòng xe" parent="menu_rental_configuration" action="action_rental_vehicle_type" sequence="20" groups="motorbike_rental_core.group_rental_manager"/>
</odoo>