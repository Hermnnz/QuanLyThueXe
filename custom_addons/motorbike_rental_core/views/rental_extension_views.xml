<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rental_extension_list" model="ir.ui.view">
        <field name="name">rental.extension.list</field>
        <field name="model">rental.extension</field>
        <field name="arch" type="xml">
            <list string="Yêu cầu gia hạn thuê xe"
                  create="0"
                  decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="customer_id"/>
                <field name="requested_end_date"/>
                <field name="additional_days"/>
                <field name="additional_amount"/>
                <field name="requested_by"/>
                <field name="requested_at"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rental_extension_form" model="ir.ui.view">
        <field name="name">rental.extension.form</field>
        <field name="model">rental.extension</field>
        <field name="arch" type="xml">
            <form string="Yêu cầu gia hạn thuê xe">
                <header>
                    <button name="action_check_and_extend" type="object"
                            string="Kiểm tra xe và gia hạn"
                            class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Từ chối"
                            groups="motorbike_rental_core.group_rental_manager"
                            invisible="not id or state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Hủy yêu cầu"
                            invisible="not id or state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected,cancelled"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã yêu cầu"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin thuê">
                            <field name="contract_id" readonly="id"/>
                            <field name="customer_id"/>
                            <field name="original_end_date"/>
                            <field name="requested_end_date"
                                   readonly="state in ('approved', 'rejected', 'cancelled')"
                                   help="Chọn thời gian trả mới; phải sau thời gian trả hiện tại."/>
                            <field name="reason"
                                   readonly="state in ('approved', 'rejected', 'cancelled')"/>
                        </group>
                        <group string="Chi phí gia hạn">
                            <field name="currency_id" invisible="1"/>
                            <field name="original_rental_days"/>
                            <field name="additional_days"/>
                            <field name="additional_amount"/>
                            <field name="requested_by"/>
                            <field name="requested_at"/>
                            <field name="reviewed_by"/>
                            <field name="reviewed_at"/>
                        </group>
                    </group>
                    <group string="Xử lý từ chối"
                           invisible="state not in ('pending', 'rejected')">
                        <field name="rejection_reason"
                               readonly="state in ('approved', 'rejected', 'cancelled')"
                               groups="motorbike_rental_core.group_rental_manager"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_extension_search" model="ir.ui.view">
        <field name="name">rental.extension.search</field>
        <field name="model">rental.extension</field>
        <field name="arch" type="xml">
            <search string="Tìm yêu cầu gia hạn">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="customer_id"/>
                <filter name="pending" string="Chờ kiểm tra"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Đã gia hạn"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Từ chối"
                        domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <record id="action_rental_extension" model="ir.actions.act_window">
        <field name="name">Yêu cầu gia hạn</field>
        <field name="res_model">rental.extension</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_rental_extension_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="menu_rental_extension" model="ir.ui.menu">
        <field name="name">Yêu cầu gia hạn</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
