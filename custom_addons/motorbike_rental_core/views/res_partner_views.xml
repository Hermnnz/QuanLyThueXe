<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_rental_customer_list" model="ir.ui.view">
        <field name="name">res.partner.rental.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Khách hàng thuê xe">
                <field name="name"/>
                <field name="phone"/>
                <field name="email" optional="show"/>
                <field name="activity_ids" string="Thông báo" widget="list_activity" optional="show"/>
                <field name="rental_id_number" optional="show"/>
                <field name="rental_driver_license" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_rental_customer_search" model="ir.ui.view">
        <field name="name">res.partner.rental.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Tìm khách hàng thuê xe">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="rental_id_number" string="CCCD/CMND"/>
                <field name="rental_driver_license" string="Giấy phép lái xe"/>
                <filter name="has_contracts" string="Đã có hợp đồng" domain="[('rental_contract_ids', '!=', False)]"/>
                <filter name="has_documents" string="Có hồ sơ PDF" domain="[('rental_document_ids', '!=', False)]"/>
                <separator/>
                <filter name="group_city" string="Nhóm theo thành phố" context="{'group_by': 'city'}"/>
            </search>
        </field>
    </record>

    <record id="view_partner_form_rental" model="ir.ui.view">
        <field name="name">res.partner.form.rental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Thuê xe" name="rental" groups="motorbike_rental_core.group_rental_user">
                    <group>
                        <group>
                            <field name="is_rental_customer"/>
                            <field name="rental_id_number"/>
                            <field name="rental_driver_license"/>
                        </group>
                        <group>
                            <field name="rental_notes"/>
                        </group>
                    </group>
                    <separator string="Hồ sơ PDF"/>
                    <field name="rental_document_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="document_date"/>
                            <field name="file" widget="binary" filename="filename"/>
                            <field name="filename" column_invisible="True"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <field name="rental_contract_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="total_amount"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_rental_customer" model="ir.actions.act_window">
        <field name="name">Khách hàng thuê xe</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_rental_customer', '=', True)]</field>
        <field name="search_view_id" ref="view_rental_customer_search"/>
    </record>

    <record id="action_rental_customer_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rental_customer_list"/>
        <field name="act_window_id" ref="action_rental_customer"/>
    </record>

    <menuitem id="menu_rental_customer" name="Khách hàng thuê xe" parent="menu_rental_management" action="action_rental_customer" sequence="20" groups="motorbike_rental_core.group_rental_user"/>
</odoo>